)abbrev domain TOPEXT SubTopology
++ Author: Martin Baker
++ Description:
++   This is a complete lattice in that it has all meets and joins of open sets.
++   These meets and joins can be extended to the whole topology, so it is a sub-topology.
++   We can also define meets and joins of the sub-topologies themselves, these are only
++   closed for meets so, for whole sub-topologies, it is a MeetSemilattice.
++   Joins of whole sub-topologies are sets of sub-topologies, this is like glueing
++   sub-topologies together.
++   for more documentation see:
++ References:
++   https://www.euclideanspace.com/prog/scratchpad/mycode/topology/finite/

SubTopology() : Exports == Impl where
  NNI==> NonNegativeInteger
  x<<y ==> hconcat(x::OutputForm, y::OutputForm)

  Exports ==> MeetSemilattice with

    subTopology : (b:Set NNI,e:Set NNI) -> %
      ++ constructor: parameters are:
      ++ ext is extension set
      ++ lattice is complete lattice on given set
      ++ these are checked for disjointedness

    constructCover : (osProposedForThisLevel:List Set NNI,subTopolBelow:List %,grade:NNI) ->
      Union(List %,String)
        ++ Construct a set of sub-topologies that covers a given space.
        ++ This is a cover for a given grade built from the grade below it.
        ++ Attempts to find smallest cover, but not guaranteed smallest as it does not do exhaustive search.

    isCover? : (cover:List %,space:List Set NNI,grade:NNI) -> Boolean
      ++ return true if 'cover' is cover of given space

    members1 : (s1:%) -> List NNI
      ++ all members in both lattice and extension

    memberElement? : (x:NNI, s1:%) -> Boolean
      ++ is an element a member of this sub-lattice

    memberOpenSet? : (x:Set NNI, s1:%) -> Boolean
      ++ is an open set a member of this sub-lattice

    isSubset? : (a : %, b : %) -> Boolean
      ++ returns true if a is subset of b

    empty1? : (s1 : %) -> Boolean
      ++ true if both lattice and extension are empty

    cardinality1 : (s1:%) -> NNI
      ++ number of elements in both lattice and extension

    selectGrade : (a:%,degree:NNI) -> List Set NNI
      ++ return all sets that have 'degree' elements

    allOpenLists : (a:%) -> List List NNI
      ++ Power set of lattice + ext

    allOpenSets : (a:%) -> List Set NNI

    join : (a:%, b:%) -> List %
      ++ The union of two complete lattices is not closed
      ++ so produce a list instead

  Impl ==> add

   -- lattice represents complete lattice on given set
   -- ext is extension set. Can think of this as the base of the lattice.
   Rep := Record(lattice:Set NNI,ext:Set NNI)

   plusSeperatedList(ts:List OutputForm) : OutputForm ==
     res:List OutputForm := []
     for t in ts for i in 1.. repeat
       if i=1
         then res := cons(t,res)
         else
           res := cons(message "+",res)
           res := cons(t,res)
     hconcat (reverse res)

   -- constructor: parameters are:
   -- ext is extension set
   -- lattice is complete lattice on given set
   -- these are checked for disjointedness
   subTopology(e:Set NNI,b:Set NNI) : % ==
     for y in members(b) repeat
       if member?(y,e) then
         print _
         hconcat((brace plusSeperatedList [x::OutputForm for x in parts e]$List(OutputForm)), _
         (brace plusSeperatedList [x::OutputForm for x in parts b]$List(OutputForm)))
         error "lattice and ext must be disjoint"
     [b,e]

   -- local helper function for allOpenLists
   -- to generate complete lattice (power set)
   powerSet(s:List NNI) : List List NNI ==
     empty? s => [s]
     concat(p:=powerSet(rest s),[cons(first s,x) for x in p])

   -- Power set of lattice + ext
   allOpenLists(a:%) : List List NNI ==
     lat:List NNI := members(a.lattice)
     e:List NNI := members(a.ext)
     expanded:List List NNI := powerSet lat
     [concat(x,e) for x in expanded]

   -- Power set of lattice + ext
   allOpenSets(a:%) : List Set NNI ==
     lat:List NNI := members(a.lattice)
     e:List NNI := members(a.ext)
     expanded:List List NNI := powerSet lat
     [set concat(x,e) for x in expanded]

   powerSetOfSets(s:List Set NNI) : List List Set NNI ==
     empty? s => [s]
     p:=powerSetOfSets(rest s)
     concat(p,[cons(first s,x) for x in p])

   sortMeets(a: Record(comb:List Set NNI,meetSet:Set NNI),_
             b: Record(comb:List Set NNI,meetSet:Set NNI)) : Boolean ==
     #(a.comb) > #(b.comb)

   isCover?(cover:List %,space:List Set NNI,grade:NNI) : Boolean ==
     oss : List Set NNI := [] -- all open sets in this cover
     for c in cover repeat
       oss := concat (oss,allOpenSets(c))
     for sp in space repeat
       if not member?(sp,oss) then return false
     true

   -- returns true if a is subset of b
   isSubset?(a : %, b : %) : Boolean ==
     osa : List Set NNI := allOpenSets(a)
     osb : List Set NNI := allOpenSets(b)
     for s in osa repeat
       if not member?(s,osb) then return false
     true

   addSubTopolIfNew(cover:List %,subTopolBelow:List %) : List % ==
     res:List % := subTopolBelow
     for c in cover repeat
       if not member?(c,subTopolBelow) then
         res := cons(c,res)
     res

   -- Construct a set of sub-topologies that covers a given space
   -- This space is defined in terms of open sets of a given grade
   -- There is an additional test that the result is compatible with the open sets below this grade
   constructCover(osProposedForThisLevel:List Set NNI,subTopolBelow:List %,grade:NNI) : _
   Union(List %,String) ==
     osBelow:List Set NNI := []
     for t in subTopolBelow repeat
       osBelow := concat(allOpenSets(t),osBelow)
     -- take all combinations
     combs:List List Set NNI := powerSetOfSets(osProposedForThisLevel)
     if combs=[] then return "failed"::Union(List %,String)
     -- 'spaceSoFar' holds all open sets proposed upto this grade
     spaceSoFar:List Set NNI := concat(osProposedForThisLevel,osBelow)
     -- take meets of them
     meets:List Record(comb:List Set NNI,meetSet:Set NNI) :=
        [[x,reduce(intersect,x)] for x in combs | not(x=[])]
     -- order with longest first
     orderedMeets:List Record(comb:List Set NNI,meetSet:Set NNI) := sort(sortMeets,meets)
     -- build up a cover
     cover:List % :=[]
     for y in orderedMeets repeat
       comb1:List Set NNI := y.comb
       meet1:Set NNI := y.meetSet
       -- remove meet1 from each of comb1 then take union
       comb2:List Set NNI := [difference(s,meet1) for s in comb1]
       comb3:Set NNI := reduce(union,comb2,set [])
       if member?(meet1,osBelow) or meet1=set[] or empty?(meet1) or empty?(comb3) then
         cover:=concat(subTopology(meet1,comb3),cover)
       -- is it a cover yet
       if isCover?(cover,spaceSoFar,grade) then
         -- TODO need to check for duplicates ***************************************
         return addSubTopolIfNew(cover,subTopolBelow)
     "failed"::Union(List %,String)

   -- meet of two sub topologies
   _/_\(a:%, b:%) : % ==
     aext:Set NNI := a.ext
     alat:Set NNI := a.lattice
     bext:Set NNI := b.ext
     blat:Set NNI := b.lattice
     if (empty1? a) or (empty1? b) then return [set [],set []]
     if aext=bext
       then
         if alat=blat then return a
         return [intersect(alat,blat),set []]
       else
         m1:Set NNI := intersect(alat,alat)
         m2:Set NNI := intersect(blat,blat)
         return [union(m1,m2),set []]
     [set [],set []]

   -- The union of two complete lattices is not closed
   -- so produce a list instead
   join(a:%, b:%) : List % ==
     if a=b then return [a]
     if (empty1? a) and (empty1? b) then return []
     if empty1? a then return [b]
     if empty1? b then return [a]
     [a,b]

   plusSeperatedList(ts:List OutputForm) : OutputForm ==
     res:List OutputForm := []
     for t in ts for i in 1.. repeat
       if i=1
         then res := cons(t,res)
         else
           res := cons(message "+",res)
           res := cons(t,res)
     hconcat (reverse res)

   coerce(s : %) : OutputForm ==
     if empty?(s.ext) and empty?(s.lattice) then return (message "0")
     if empty?(s.ext) then
       return (message "P") << _
              (brace plusSeperatedList [x::OutputForm for x in parts (s.lattice)]$List(OutputForm))
     if empty?(s.lattice) then
       return (brace plusSeperatedList [x::OutputForm for x in parts (s.ext)]$List(OutputForm))
     (brace plusSeperatedList [x::OutputForm for x in parts (s.ext)]$List(OutputForm)) << _
     (message "*P") << _
     (brace plusSeperatedList [x::OutputForm for x in parts (s.lattice)]$List(OutputForm))

   _=(a:%,b:%) : Boolean ==
     (a.lattice = b.lattice) and (a.ext = b.ext)

   members1(s1:%) : List NNI ==
     s:Set NNI := s1.lattice
     s2:Set NNI := s1.ext
     concat(members(s),members(s2))

   -- is an element a member of this sub-lattice
   memberElement?(x:NNI, s1:%) : Boolean ==
     for y in members1(s1) repeat
       if x=y then return true
     false

   -- is an open set a member of this sub-lattice
   memberOpenSet?(x:Set NNI, s1:%) : Boolean ==
     oss : List Set NNI := allOpenSets(s1)
     member?(x,oss)

   empty1?(s1 : %) : Boolean ==
     empty?(s1.ext) and empty?(s1.lattice)

   cardinality1(s1:%) : NNI ==
     s:Set NNI := s1.ext
     s2:Set NNI := s1.lattice
     cardinality(s)+cardinality(s2)

   -- return all sets that have 'degree' elements
   selectGrade(a:%,degree:NNI) : List Set NNI ==
     s:Set NNI := a.ext
     s2:Set NNI := a.lattice
     r : List List Integer :=
       [reverse subSet(#s2,degree,i)$SymmetricGroupCombinatoricFunctions for
         i in 0..binomial(#s2,degree)-1]
     res : List Set NNI := [set [elt(members(s2),x+1) for x in y] for y in r]
     if cardinality(s)=degree then res:= cons(s,res)
     res

)abbrev domain TOPFIN TopologyFinite
++ Author: Martin Baker
++ Description:
++   A set of open sets.
++   Can also be thought of as a subset of the power set.
++   It may be sufficient to use only a basis where the full
++   topology can be reconstructed from it.
++   for more documentation see:
++ References:
++   https://www.euclideanspace.com/prog/scratchpad/mycode/topology/finite/

TopologyFinite() : Exports == Impl where
  NNI==> NonNegativeInteger
  x<<y ==> hconcat(x::OutputForm, y::OutputForm)

  Exports ==> SetCategory() with

    topologyFinite : (List List NNI) -> %
      ++ constructor

    topologyFinite2 : (List SubTopology) -> %
      ++ constructor

    topologyFiniteTrivial : () -> %
      ++ Constructor for trivial topology
      ++ Only empty(doesn't need to be explicitly included) and full open sets

    topologyFiniteDiscrete : (dim:NNI) -> %
      ++ Constructor for discrete topology
      ++ includes all open sets
      ++ Don't need to explicitly include empty

    topologyFiniteLeftOrder : (dim:NNI) -> %
      ++ Constructor for order topology
      ++ The order topology may be considered on partially ordered sets as
      ++ well as linearly ordered sets
      ++ The open sets are {x | x<b} where b is 1..max
      ++ On a linearly ordered set it coincides with the interval topology

    validateTopology : (a:%,maxDegree:NNI) -> Boolean
      ++ check this topology has all meets and joins

    validateTopologyList : (a:List %,maxDegree:NNI) -> Boolean
      ++ check this topology has all meets and joins
      ++ also check for duplicates

    getTopology : (a:%) -> List List NNI
      ++ returns open sets as list of list

    getOpenSets : (a:%) -> List SubTopology
      ++ returns open sets as list of set

    full2basis : (a:%) -> %
      ++ Remove non-basis open sets
      ++ That is, for each element, only the smallest open set that includes it.

    basis2full : (a:%) -> %
      ++ Add all unions of open sets not already included

    coerce : (x : %) -> OutputForm
      ++ display as symbols

    getDimension : (a : %) -> NNI

    product : (a : %, b : %) -> %

    powerSetGradedOld : (d:NNI,grade:NNI) -> List List NNI

    nerveConstruction : (a : %) -> FiniteSimplicialComplex(Integer)
      ++ A nerve construction creates a simplicial complex with the
      ++ topological properties of a given set family.
      ++ The nerve construction is based on a cover of the set family
      ++ The resulting complex is a discrete representation of that cover.

    testValidTopol : (allDegree:List SubTopology,degree:NNI) -> Boolean

    allTopologiesOnSet : (s : List NNI) -> List %
      ++ Given a set construct a list of all possible topologies on that set
      ++ Warning: This function can return very long lists, if the input set is 6 or
      ++ more elements then the computer may run out of resources and crash.
      ++ I have written an explanation of this algorithm on the web page here:
      ++ https://www.euclideanspace.com/maths/topology/topologicalSpace/finite/all/index.htm

    countAllTopologiesOnSet : (s : List NNI) -> NNI
      ++ Given a set count all possible topologies on that set


  Impl ==> add

   -- A topology on a finite set.
   -- Defined by a list of open sets. Elements are labelled by a NNI number.
   Rep := Record(basis:Boolean,topology:List SubTopology)

   getTopology(a:%) : List List NNI ==
     t:List SubTopology := a.topology
     [members1(a) for a in t]

   -- returns open sets as list of set
   getOpenSets(a:%) : List SubTopology ==
     a.topology

   setTopologyFromList(t:List(List(NNI))) : List SubTopology ==
     [subTopology(set [a],set []) for a in t]

   -- constructor
   topologyFinite(a : List List NNI) : % ==
     [false,setTopologyFromList(a)]

   topologyFinite2(a : List SubTopology) : % ==
     [false,a]

   topologyFiniteTrivial() : % ==
     [false,empty]

   -- local function to add if new
   addIfNew(lst : List(List(NNI)), unsorted : List(NNI)) : List(List(NNI)) ==
       if empty?(unsorted) then return lst
       sorted : List(NNI) := sort(unsorted)
       if member?(sorted, lst) then return lst
       cons(sorted,lst)

   -- generate discrete topology
   genDiscreteTopology(lst : List(List(NNI)),level : NNI,
       thisOpenSet : List(NNI), dim : NNI) : List(List(NNI)) ==
     -- print(message "genDiscreteTopology(" << lst  << message ","
     --  << level  << message "," << thisOpenSet  << message "," << dim << message ")")
     top1:List List NNI := lst
     for i in 1..dim repeat
       openset1 : List NNI := [i]
       if not member?(i,thisOpenSet) then
         -- print(message "genDiscreteTopology not member(" << thisOpenSet  << message ","
         --   << i  << message ")")
         openset2 : List(NNI) := concat(thisOpenSet,openset1)
         if (level+1)<dim then
           top1 := genDiscreteTopology(top1,level+1,openset2,dim)
         top1 := addIfNew(top1,openset2)
     top1

   topologyFiniteDiscrete(dim:NNI) : % ==
     top1:List List NNI := empty
     top1 := genDiscreteTopology(top1,1,empty,dim)
     [false,setTopologyFromList(top1)]

   -- generate order topology
   genOrderTopology(lst : List(List(NNI)),level : NNI,
       thisOpenSet : List(NNI), dim : NNI) : List(List(NNI)) ==
     -- print(message "genOrderTopology(" << lst  << message ","
     --  << level  << message "," << thisOpenSet  << message "," << dim << message ")")
     top1:List List NNI := lst
     openset1:List NNI := []
     for i in 1..dim repeat
       -- print(message "genOrderTopology loop(" << top1  << message "," << i  << message ")")
       openset1 := cons(i,openset1)
       top1 := cons(openset1,top1)
     reverse top1

   -- generate order topology
   topologyFiniteLeftOrder(dim:NNI) : % ==
     top1:List List NNI := empty
     top1 := genOrderTopology(top1,1,empty,dim)
     [false,setTopologyFromList(top1)]

   -- check this topology has all meets and joins
   validateTopology(a:%,maxDegree:NNI) : Boolean ==
     top1:List SubTopology := getOpenSets(a)
     top12:List List List NNI := [allOpenLists(x) for x in top1]
     top2:List List NNI := reduce(concat,top12)
     if empty?(top1) then return true
     for os1 in top1 repeat
       for os2 in top1 repeat
         --join:SubTopology := os1 \/ os2
         --meet:SubTopology := os1 /\ os2
         m:SubTopology := os1 /\ os2
         if not empty1?(m) then
           --for m2 in m repeat
             --if not member?(m2,top2) then
               print(message "validateTopology invalid:" << top1)
               print(message " os1=" << os1 << message " os2=" << os2)
               print(message " meet=" << m)
               return false
     true

   -- check this topology has all meets and joins
   -- also check for duplicates
   validateTopologyList(a:List %,maxDegree:NNI) : Boolean ==
     for topol in a repeat
       if not validateTopology(topol,maxDegree) then
         print(message "validateTopologyList invalid:" << topol)
         return false
     true


   -- To find a basis: for every element of the set find the smallest
   -- open set that contains it.
   -- Remove non-basis open sets
   -- That is, for each element, only the smallest open set that includes it.
   full2basis(a:%) : % ==
     -- assume number of elements is maximum index
     numEle:NNI := 0
     top1:List List NNI := getTopology(a)
     for x in top1 repeat
       for y in x repeat
         if y>numEle then numEle:=y
     basisSets:List List NNI := empty
     for currEle in 1..numEle repeat
       basisCandidate:List NNI := empty
       minSize:NNI := 0
       for currOpenSet in top1 repeat
         currSize:NNI := #currOpenSet
         if member?(currEle,currOpenSet) and not empty?(currOpenSet) and
          (minSize=0 or currSize < minSize) then
            --print(message "adding" << currOpenSet  << message " minSize="
            --  << minSize << message " currEle=" << currEle)
            basisCandidate := currOpenSet
            minSize := #currOpenSet
       basisSets := addIfNew(basisSets,basisCandidate)
     [true,setTopologyFromList(basisSets)]

   unionLocal(a:List NNI, b:List NNI) : List NNI ==
     res:List NNI := a
     for x in b repeat
       if not member?(x, res) then res:=cons(x,res)
     res

   -- Add all unions of open sets not already included
   basis2full(a:%) : % ==
     top1:List List NNI := getTopology(a)
     top2:List List NNI := copy(top1) -- so we dont alter top1 inside loop
     for x in top1 repeat
       for y in top1 repeat
         z : List NNI := sort (unionLocal(x,y))
         top2 := addIfNew(top2,z)
         -- print(message "x=" << x  << message " y="
         --  << y << message " union=" << z)
     [false,setTopologyFromList(top2)]

   -- display
   coerce(x : %) : OutputForm ==
     x1:List SubTopology := x.topology
     msg:OutputForm := if x.basis then message "basis=" else message "topology="
     msg << bracket[(a::OutputForm) for a in x1]

   _=(a:%,b:%) : Boolean ==
     a=b

   getDimension(a : %) : NNI ==
     numEle:NNI := 0
     top1:List SubTopology := a.topology
     for x in top1 repeat
       if cardinality1(x)$SubTopology > numEle then numEle := cardinality1(x)$SubTopology
     numEle

   shift(a : SubTopology, distance : NNI) : SubTopology ==
     subTopology(set [x+distance for x in members1(a)],set [])

   productOfSets(a : SubTopology, b : SubTopology) : SubTopology ==
     -- should check that a and b are disjoint
     --a \/ b
     a

   product(a : %, b : %) : % ==
     top1:List SubTopology := (full2basis a).topology
     top2:List SubTopology := (full2basis b).topology
     -- following only works for full not basis
     sizea:NNI := getDimension(a)
     sizeb:NNI := getDimension(a)
     top2s:List SubTopology := [shift(x,sizea) for x in top2]
     res:List SubTopology := empty
     for x in top1 repeat
       for y in top2s repeat
         res := cons(productOfSets(x,y),res)
     [true,res]

   -- local function to add if new
   addIfNew2(lst : List SubTopology, unsorted : SubTopology) : List SubTopology ==
       if empty1?(unsorted) then return lst
       if member?(unsorted, lst) then return lst
       cons(unsorted,lst)

   -- https://sauln.github.io/blog/towers-nerves/
   -- A nerve construction creates a simplicial complex with the
   -- topological properties of a given set family.
   -- The nerve construction is based on a cover of the set family
   -- The resulting complex is a discrete representation of that cover.
   nerveConstruction(a : %) : FiniteSimplicialComplex(Integer) ==
     -- For each nonempty intersection of n elements in the cover,
     -- add an (n-1)-dimensional simplex.
     top1:List SubTopology := (a::Rep).topology
     intersections:List SubTopology := empty
     for x in top1 repeat
       for y in top1 repeat
         intersec:SubTopology := x /\ y
         --intersections := addIfNew2(intersections,intersec)
         -- ***************** needs fixing ************************
         -- print(message "x=" << x  << message " y="
         --    << y << message " intersec=" << intersec)
     -- print(message "intersections=" << intersections )
     -- Add a vertex for each element in the cover.
     -- Add an edge between two vertices if the corresponding sets overlap.
     leng:NNI := #intersections
     eles:List Integer := [x for x in 1..leng]
     top1:List List NNI := [members1(a) for a in intersections]
     simplicialComplex(eles,top1)

   subset(li:List NNI, n:NNI) : List NNI ==
     [x for x in li for i in 0..#li-1 | bit?(n, i)]

   powerSet(s:List NNI) : List List NNI ==
     empty? s => [s]
     concat(p:=powerSet(rest s),[cons(first s,x) for x in p])

   powerSetOfLists(s:List List NNI) : List List List NNI ==
     empty? s => [s]
     p:=powerSetOfLists(rest s)
     concat(p,[cons(first s,x) for x in p])

   -- Return all combinations of k from n
   -- example:
   -- if k=1 and n=3 then return [{1}],[{2}],[{3}]]
   kFromNCombinations(k1:NNI,n1:NNI) : List List NNI ==
     n:Integer := n1
     k:Integer := k1
     r : List List Integer :=
       [reverse subSet(n,k,i)$SymmetricGroupCombinatoricFunctions for
         i in 0..binomial(n,k)-1]
     [[(y+1)::NNI for y in x] for x in r]

   -- Return combinations of all combinations of k from n
   -- if k=1 and n=3  then return [{1}],[{2}],[{3}],[{1},{2}] ... [{1},{2},{3}]
   kFromNCombComb(k1:NNI,n1:NNI) : List List List NNI ==
     powerSetOfLists(kFromNCombinations(k1,n1))

   grade(s:List List NNI,x:NNI) : List List NNI ==
     empty? s => s
     reverse [os for os in s | #os=x]

   listMeet(os:List NNI,os2:List NNI) : List NNI ==
     res: List NNI := []
     for e in os repeat
       for e2 in os2 repeat
         if e=e2 then res:=cons(e,res)
     if empty? res then return res
     sort res

   listJoin(os:List NNI,os2:List NNI) : List NNI ==
     res: List NNI := []
     for e in os repeat
       if not entry?(e,res) then res:=cons(e,res)
     for e in os2 repeat
       if not entry?(e,res) then res:=cons(e,res)
     if empty? res then return res
     sort res

   -- Return value indicates if the topology is valid upto the degree so far.
   -- degree 1 (singletons) contains combinations of open sets like [[1],[2]] etc.
   -- degree 2 contains combinations of open sets like [[1,2],[2,3]] etc.
   -- and so on.
   -- Even if this returns 'true' there may be higher degree open sets still required.
   -- (only checks downward)
   -- parameter 'allDegree' holds a possible topology which is valid upto the degree below
   -- returns true if these are compatible
   testValidTopol(allDegree:List SubTopology,
                  degree:NNI) : Boolean ==
     -- For a valid topology all joins and meets must exist
     -- print(message "testValidTopol allDegree=" << allDegree <<
     --      message " degree=" << degree)
     for x in allDegree for i in 1.. repeat
       for y in allDegree for i2 in 1.. repeat
         if i2>i then
           osJoin:List SubTopology := join(x,y)
           -- if cardinality1(osJoin) <= degree then -- can only check upto this degree
           --   if not entry?(osJoin,allDegree) then
           --     return false
           osMeet:SubTopology := x /\ y
           -- if not cardinality1(osMeet)=0 then
           --   if not entry?(osMeet,allDegree) then
           --     return false
     true

   -- The base in SubTopology will contain multiple grades, this function filters out
   -- one specific grade.
   selectGrade(allOpenSetsBelowThis:List SubTopology,degree:NNI) : List Set NNI ==
     res:List Set NNI := []
     for e in allOpenSetsBelowThis repeat
       s:List Set NNI := selectGrade(e,degree)
       res := concat(res,s)
     res



   -- Given all potential topologies containing upto 'degree-1' open sets add
   -- 'degree' open sets then call recursively until we get to 'maxDegree'.
   -- parameter 'allOpenSetsBelowThis' is all potential topologies containing only upto 'degree-1' open sets.
   -- degree 1 (singletons) contains combinations of open sets like [{1},{2}] etc.
   -- degree 2 contains combinations of open sets like [{1,2},{2,3}] etc. with degree 2
   -- and so on.
   allTopologiesRecursive(allOpenSetsBelowThis : List SubTopology,
                          degree:NNI,maxDegree:NNI) : List % ==
     -- only at top degree are we sure we have valid topology
     degree = maxDegree => [topologyFinite2 allOpenSetsBelowThis]
     -- 'thisLevel' will hold all possible combinations of open sets for this degree
     thisLevel:List List List NNI := kFromNCombComb(degree,maxDegree)
     -- 'allValidTopol' will hold the open sets below this level plus
     -- this level open sets, if they pass validity test.
     allValidTopol:List % := []
     --print(message "allTopologiesRecursive allOpenSetsBelowThis=" << allOpenSetsBelowThis <<
     --      message " thisLevel=" << thisLevel <<
     --      message " mustHaveSets=" << mustHaveSets)
     -- Now loop through all combinations at this grade
     -- 'topolAtLevel:List List NNI' will be current combination of open sets at this grade
     for topolAtLevel in thisLevel repeat
       osAtThisLevel:List Set NNI := [set x for x in topolAtLevel]
       topolAtLevelExt: List SubTopology := []
       r := constructCover(osAtThisLevel,allOpenSetsBelowThis,degree)
       if r case (List SubTopology) then
         topolAtLevelExt := r
         validTopol : List % := allTopologiesRecursive(topolAtLevelExt,
                            degree+1,maxDegree)
         allValidTopol := concat(validTopol,allValidTopol)
       print(message "allTopologiesRecursive allOpenSetsBelowThis=" << allOpenSetsBelowThis <<
             message " degree=" << degree <<
             message " topolAtLevel=" << topolAtLevel <<
             message " allValidTopol=" << allValidTopol)
     allValidTopol

   -- Given a set, construct a list of all possible topologies on that set
   -- Warning: This function can return very long lists, if the input set is 6 or
   -- more elements then the computer may run out of resources and crash.
   -- I have written an explanation of this algorithm on the web page here:
   -- https://www.euclideanspace.com/maths/topology/topologicalSpace/finite/all/index.htm
   allTopologiesOnSet(s : List NNI) : List % ==
     dim:NNI := #s
     if dim=0 then return [topologyFinite [[]]]
     if dim=1 then return [topologyFinite cons([[]],[s])]
     -- start with degree 0, an empty open set
     allTopologiesRecursive([[]],0,dim)

   -- Given a set, count all possible topologies on that set
   countAllTopologiesOnSet(s : List NNI) : NNI ==
     dim:NNI := #s
     if dim=0 then return 0
     if dim=1 then return 2
     -- start with degree 0, an empty open set
     #allTopologiesRecursive([[]],1,dim)

