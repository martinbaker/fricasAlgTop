-- To run this code on FriCAS first install and run the  FriCAS code as described on
-- https://fricas.sourceforge.net/download.html
-- Then compile this code:
-- )co fricas/topology2.spad
--
-- Here are some things to test the code:
--
-- allTopologiesOnSet [1,2,3]
-- subTopology(set [[1]],set [[2,3]])
-- cc1 := allLattices([1,2,3])
-- allDivisionsSet([1,2,3])
--
-- )set output length 245
-- allTopologiesOnSet [1,2,3,4]
-- cc1 := constructCover([set [1],set [2],set [3]],[],1)
-- cc2 := constructCover([set [1],set [2]],[],1)
-- cc3 := constructCover([set [1]],[],1)
-- constructCover([set [1,2],set [1,3],set [2,3]],cc1,2)
-- constructCover([set [1,2],set [1,3],set [2,3]],cc2,2)
-- constructCover([set [1,2]],cc3,2) -- *********************fails ****************
-- validateTopologyList(allTopologiesOnSet [1,2,3,4],4)
--
-- test TopologyFinite
-- y1 := topologyFiniteLeftOrder(3)
-- y2 := topologyFiniteDiscrete(3)
-- y3 := full2basis y2
-- y4 := basis2full y3
-- product(y1,y2)

)abbrev domain TOPEXT SubTopology
++ Author: Martin Baker
++ Description:
++   This is a complete lattice of open sets, in that it has all meets and joins of open sets.
++   These meets and joins can be extended to the whole topology, so it is a sub-topology.
++   We can also define meets and joins of the sub-topologies themselves, these are only
++   closed for meets so, for whole sub-topologies, it is a MeetSemilattice.
++   Joins of whole sub-topologies are not closed but are sets of sub-topologies, this is
++   like glueing sub-topologies together.
++   for more documentation see:
++ References:
++   https://www.euclideanspace.com/prog/scratchpad/mycode/topology/finite/

SubTopology() : Exports == Impl where
  NNI==> NonNegativeInteger
  x<<y ==> hconcat(x::OutputForm, y::OutputForm)
  PARTITION ==> Record(result:List List NNI,complement:List NNI)

  Exports ==> MeetSemilattice with

    subTopology : (start:Set List NNI,finish:Set List NNI) -> %
      ++ constructor: parameters are -
      ++ start: is extension set. This is an open set which is included in every
      ++        node so we factor it out to here.
      ++ finish: is complete lattice on given set
      ++ these are checked for disjointedness

    members1 : (s1:%) -> List List NNI
      ++ all members in both lattice and extension

    memberElement? : (x:List NNI, s1:%) -> Boolean
      ++ is an element a member of this sub-lattice

    memberOpenSet? : (x:Set List NNI, s1:%) -> Boolean
      ++ is an open set a member of this sub-lattice

    memberOpenSetList? : (x:Set List NNI, s1:List %) -> Boolean
      ++ is an open set a member of this sub-lattice

    isSubset? : (a : %, b : %) -> Boolean
      ++ returns true if a is subset of b

    empty1? : (s1 : %) -> Boolean
      ++ true if both lattice and extension are empty

    cardinality1 : (s1:%) -> NNI
      ++ number of elements in both lattice and extension

    selectGrade : (a:%,degree:NNI) -> List Set List NNI
      ++ return all sets that have 'degree' elements

    allOpenLists : (a:%) -> List List List NNI
      ++ Power set of lattice + ext

    allOpenSets : (a:%) -> List Set List NNI

    top : (a:%) -> List NNI

    join : (a:%, b:%) -> List %
      ++ The union of two complete lattices is not closed
      ++ so produce a list instead

    setComplement : (topLevel : List NNI,thisLattice:%) -> List NNI
      ++ Gather all elements included in thisLattice and then take the complement
      ++ to determine missing elements.

  Impl ==> add

   -- finish represents complete lattice on given set
   -- start is extension set. Can think of this as the base of the lattice.
   Rep := Record(start:Set List NNI,finish:Set List NNI)

   plusSeperatedList(ts:List OutputForm) : OutputForm ==
     res:List OutputForm := []
     for t in ts for i in 1.. repeat
       if i=1
         then res := cons(t,res)
         else
           res := cons(message "+",res)
           res := cons(t,res)
     hconcat (reverse res)

   -- constructor: parameters are:
   -- start is extension set
   -- finish is complete lattice on given set
   -- these are checked for disjointedness
   subTopology(start:Set List NNI,finish:Set List NNI) : % ==
     for y in members(start) repeat
       if member?(y,finish) then
         print _
         hconcat((brace plusSeperatedList [x::OutputForm for x in parts finish]$List(OutputForm)), _
         (brace plusSeperatedList [x::OutputForm for x in parts start]$List(OutputForm)))
         error "finish and start must be disjoint"
     [start,finish]

   -- local helper function for allOpenLists
   -- to generate complete lattice (power set)
   powerSet(s:List List NNI) : List List List NNI ==
     empty? s => [s]
     concat(p:=powerSet(rest s),[cons(first s,x) for x in p])

   -- Power set of lattice + start
   allOpenLists(a:%) : List List List NNI ==
     lat:List List NNI := members(a.finish)
     e:List List NNI := members(a.start)
     expanded:List List List NNI := powerSet lat
     [concat(x,e) for x in expanded]

   -- Power set of lattice + start
   allOpenSets(a:%) : List Set List NNI ==
     lat:List List NNI := members(a.finish)
     e:List List NNI := members(a.start)
     expanded:List List List NNI := powerSet lat
     [set concat(x,e) for x in expanded]

   powerSetOfSets(s:List Set NNI) : List List Set NNI ==
     empty? s => [s]
     p:=powerSetOfSets(rest s)
     concat(p,[cons(first s,x) for x in p])

   sortMeets(a: List Set NNI,b: List Set NNI) : Boolean ==
     #a > #b

   -- returns true if a is subset of b
   isSubset?(a : %, b : %) : Boolean ==
     osa : List Set List NNI := allOpenSets(a)
     osb : List Set List NNI := allOpenSets(b)
     for s in osa repeat
       if not member?(s,osb) then return false
     true

   top(a:%) : List NNI ==
     m : List List NNI := members1(a)
     if m=[] or m=[[]] then return []
     r : List NNI := reduce(setUnion,m)
     sort r

   -- meet of two sub-topologies
   _/_\(a:%, b:%) : % ==
     astart:Set List NNI := a.start
     alat:Set List NNI := a.finish
     bstart:Set List NNI := b.start
     blat:Set List NNI := b.finish
     if (empty1? a) or (empty1? b) then return [set [],set []]
     if astart=bstart then
         if alat=blat then return a
         return [intersect(alat,blat),set []]
     m1:Set List NNI := intersect(alat,alat) -- interset with itself????????????????
     m2:Set List NNI := intersect(blat,blat)
     [union(m1,m2),set []]

   -- The union of two complete lattices is not closed
   -- so produce a list instead
   join(a:%, b:%) : List % ==
     if a=b then return [a]
     if (empty1? a) and (empty1? b) then return []
     if empty1? a then return [b]
     if empty1? b then return [a]
     [a,b]

   customSeperatedList(ts:List OutputForm,seperator:String) : OutputForm ==
     res:List OutputForm := []
     #ts=1 => first ts
     for t in ts for i in 1.. repeat
       if i=1
         then res := cons(t,res)
         else
           res := cons(message seperator,res)
           res := cons(t,res)
     hconcat (reverse res)

   formatInner(osin:List NNI) : OutputForm ==
     #osin=0 => message "0"
     #osin=1 => (first osin)::OutputForm
     customSeperatedList([x::OutputForm for x in osin],"\/")

   formatOS(os:List List NNI) : OutputForm ==
     os2:List OutputForm := [formatInner(x) for x in os]
     customSeperatedList(os2,"+")

   coerce(s : %) : OutputForm ==
     st : List List NNI := parts (s.start)
     fi : List List NNI := parts (s.finish)
     if empty?(st) and empty?(s.finish) then return (message "0")
     if empty?(st) then return (message "P") << (brace (formatOS fi))
     if empty?(s.finish) then return (brace (formatOS st))
     (brace (formatOS st)) << (message "*P") << (brace (formatOS fi))

   _=(a:%,b:%) : Boolean ==
     (a.finish = b.finish) and (a.start = b.start)

   members1(s1:%) : List List NNI ==
     s:Set List NNI := s1.finish
     s2:Set List NNI := s1.start
     concat(members(s),members(s2))

   -- is an element a member of this sub-lattice
   memberElement?(x:List NNI, s1:%) : Boolean ==
     for y in members1(s1) repeat
       if x=y then return true
     false

   -- is an open set a member of this sub-lattice
   memberOpenSetList?(x:Set List NNI, s1:List %) : Boolean ==
     for s2 in s1 repeat
       oss : List Set List NNI := allOpenSets(s2)
       if member?(x,oss) then return true
     false

   -- is an open set a member of this sub-lattice
   memberOpenSet?(x:Set List NNI, s1:%) : Boolean ==
     oss : List Set List NNI := allOpenSets(s1)
     member?(x,oss)

   empty1?(s1 : %) : Boolean ==
     empty?(s1.start) and empty?(s1.finish)

   cardinality1(s1:%) : NNI ==
     s:Set List NNI := s1.start
     s2:Set List NNI := s1.finish
     -- cardinality(s)+cardinality(s2)
     0

   -- return all sets that have 'degree' elements
   selectGrade(a:%,degree:NNI) : List Set List NNI ==
     s:Set List NNI := a.start
     s2:Set List NNI := a.finish
     r : List List Integer :=
       [reverse subSet(#s2,degree,i)$SymmetricGroupCombinatoricFunctions for
         i in 0..binomial(#s2,degree)-1]
     res : List Set List NNI := [set [elt(members(s2),x+1) for x in y] for y in r]
     if cardinality(s)=degree then res:= cons(s,res)
     res

   -- gather all elements included in thisLattice and then take the complement
   -- to determine missing elements
   setComplement(topLevel : List NNI,thisLattice:%) : List NNI ==
     openSets:List List NNI := members1(thisLattice)
     elements : List NNI := if empty?(openSets) then [] else reduce(setUnion,openSets)
     c : List NNI := copy topLevel
     for x in elements repeat
       c:= remove(x,c)
     -- print(message "setComplement topLevel=" << topLevel <<
     --      message " elements=" << elements << message " c=" << c)
     c


)abbrev domain TOPFIN TopologyFinite
++ Author: Martin Baker
++ Description:
++   A set of open sets.
++   Can also be thought of as a subset of the power set.
++   It may be sufficient to use only a basis where the full
++   topology can be reconstructed from it.
++   for more documentation see:
++ References:
++   https://www.euclideanspace.com/prog/scratchpad/mycode/topology/finite/

TopologyFinite() : Exports == Impl where
  NNI==> NonNegativeInteger
  x<<y ==> hconcat(x::OutputForm, y::OutputForm)
  PARTITION ==> Record(result:List List NNI,complement:List NNI)

  Exports ==> SetCategory() with

    topologyFinite : (List List NNI) -> %
      ++ constructor

    topologyFinite2 : (List SubTopology) -> %
      ++ constructor

    topologyFiniteTrivial : () -> %
      ++ Constructor for trivial topology
      ++ Only empty(doesn't need to be explicitly included) and full open sets

    topologyFiniteDiscrete : (dim:NNI) -> %
      ++ Constructor for discrete topology
      ++ includes all open sets
      ++ Don't need to explicitly include empty

    topologyFiniteLeftOrder : (dim:NNI) -> %
      ++ Constructor for order topology
      ++ The order topology may be considered on partially ordered sets as
      ++ well as linearly ordered sets
      ++ The open sets are {x | x<b} where b is 1..max
      ++ On a linearly ordered set it coincides with the interval topology

    validateTopology : (a:%,maxDegree:NNI) -> Boolean
      ++ check this topology has all meets and joins

    validateTopologyList : (a:List %,maxDegree:NNI) -> Boolean
      ++ check this topology has all meets and joins
      ++ also check for duplicates

    allLattices : (start:List NNI,finish:List NNI) -> List PARTITION
        ++ Construct a set of sub-topologies that covers a given space.
        ++ This is a cover for a given grade, built from the grade below it.
        ++ Attempts to find smallest cover, but not guaranteed smallest as
        ++ it does not do exhaustive search.

    getTopology : (a:%) -> List List NNI
      ++ returns open sets as list of list

    getOpenSets : (a:%) -> List SubTopology
      ++ returns open sets as list of set

    full2basis : (a:%) -> %
      ++ Remove non-basis open sets
      ++ That is, for each element, only the smallest open set that includes it.

    basis2full : (a:%) -> %
      ++ Add all unions of open sets not already included

    coerce : (x : %) -> OutputForm
      ++ display as symbols

    getDimension : (a : %) -> NNI

    product : (a : %, b : %) -> %

    powerSetGradedOld : (d:NNI,grade:NNI) -> List List NNI

    nerveConstruction : (a : %) -> FiniteSimplicialComplex(Integer)
      ++ A nerve construction creates a simplicial complex with the
      ++ topological properties of a given set family.
      ++ The nerve construction is based on a cover of the set family
      ++ The resulting complex is a discrete representation of that cover.

    testValidTopol : (allDegree:List SubTopology,degree:NNI) -> Boolean

    allTopologiesOnSet : (s : List NNI) -> List %
      ++ Given a set construct a list of all possible topologies on that set
      ++ Each of these topologies is made up from sub-topologies (complete lattices)
      ++ that cover the space.
      ++ Warning: This function can return very long lists, if the input set is 6 or
      ++ more elements then the computer may run out of resources and crash.
      ++ I have written an explanation of this algorithm on the web page here:
      ++ https://www.euclideanspace.com/maths/topology/topologicalSpace/finite/extension/index.htm

    countAllTopologiesOnSet : (s : List NNI) -> NNI
      ++ Given a set count all possible topologies on that set

  Impl ==> add

   -- A topology on a finite set.
   -- Defined by a list of open sets. Elements are labelled by a NNI number.
   Rep := Record(basis:Boolean,topology:List SubTopology)

   -- returns open sets as list of set
   getOpenSets(a:%) : List SubTopology ==
     a.topology

   getTopology(a:%) : List List NNI ==
     sub : List SubTopology := a.topology
     res : List List NNI := []
     for x in sub repeat
       m:List List NNI := members1(x)
       res := concat (m,res)
     res

   setTopologyFromList(t:List(List(NNI))) : List SubTopology ==
     [subTopology(set [a],set []) for a in t]

   -- constructor
   topologyFinite(a : List List NNI) : % ==
     [false,setTopologyFromList(a)]

   topologyFinite2(a : List SubTopology) : % ==
     [false,a]

   topologyFiniteTrivial() : % ==
     [false,empty]

   -- local function to add if new
   addIfNew(lst : List(List(NNI)), unsorted : List(NNI)) : List(List(NNI)) ==
       if empty?(unsorted) then return lst
       sorted : List(NNI) := sort(unsorted)
       if member?(sorted, lst) then return lst
       cons(sorted,lst)

   -- generate discrete topology
   genDiscreteTopology(lst : List(List(NNI)),level : NNI,
       thisOpenSet : List(NNI), dim : NNI) : List(List(NNI)) ==
     -- print(message "genDiscreteTopology(" << lst  << message ","
     --  << level  << message "," << thisOpenSet  << message "," << dim << message ")")
     top1:List List NNI := lst
     for i in 1..dim repeat
       openset1 : List NNI := [i]
       if not member?(i,thisOpenSet) then
         -- print(message "genDiscreteTopology not member(" << thisOpenSet  << message ","
         --   << i  << message ")")
         openset2 : List(NNI) := concat(thisOpenSet,openset1)
         if (level+1)<dim then
           top1 := genDiscreteTopology(top1,level+1,openset2,dim)
         top1 := addIfNew(top1,openset2)
     top1

   topologyFiniteDiscrete(dim:NNI) : % ==
     top1:List List NNI := empty
     top1 := genDiscreteTopology(top1,1,empty,dim)
     [false,setTopologyFromList(top1)]

   -- generate order topology
   genOrderTopology(lst : List(List(NNI)),level : NNI,
       thisOpenSet : List(NNI), dim : NNI) : List(List(NNI)) ==
     -- print(message "genOrderTopology(" << lst  << message ","
     --  << level  << message "," << thisOpenSet  << message "," << dim << message ")")
     top1:List List NNI := lst
     openset1:List NNI := []
     for i in 1..dim repeat
       -- print(message "genOrderTopology loop(" << top1  << message "," << i  << message ")")
       openset1 := cons(i,openset1)
       top1 := cons(openset1,top1)
     reverse top1

   -- generate order topology
   topologyFiniteLeftOrder(dim:NNI) : % ==
     top1:List List NNI := empty
     top1 := genOrderTopology(top1,1,empty,dim)
     [false,setTopologyFromList(top1)]

   -- To find a basis: for every element of the set find the smallest
   -- open set that contains it.
   -- Remove non-basis open sets
   -- That is, for each element, only the smallest open set that includes it.
   full2basis(a:%) : % ==
     -- assume number of elements is maximum index
     numEle:NNI := 0
     top1:List List NNI := getTopology(a)
     for x in top1 repeat
       for y in x repeat
         if y>numEle then numEle:=y
     basisSets:List List NNI := empty
     for currEle in 1..numEle repeat
       basisCandidate:List NNI := empty
       minSize:NNI := 0
       for currOpenSet in top1 repeat
         currSize:NNI := #currOpenSet
         if member?(currEle,currOpenSet) and not empty?(currOpenSet) and
          (minSize=0 or currSize < minSize) then
            --print(message "adding" << currOpenSet  << message " minSize="
            --  << minSize << message " currEle=" << currEle)
            basisCandidate := currOpenSet
            minSize := #currOpenSet
       basisSets := addIfNew(basisSets,basisCandidate)
     [true,setTopologyFromList(basisSets)]

   unionLocal(a:List NNI, b:List NNI) : List NNI ==
     res:List NNI := a
     for x in b repeat
       if not member?(x, res) then res:=cons(x,res)
     res

   -- Add all unions of open sets not already included
   basis2full(a:%) : % ==
     top1:List List NNI := getTopology(a)
     top2:List List NNI := copy(top1) -- so we dont alter top1 inside loop
     for x in top1 repeat
       for y in top1 repeat
         z : List NNI := sort (unionLocal(x,y))
         top2 := addIfNew(top2,z)
         -- print(message "x=" << x  << message " y="
         --  << y << message " union=" << z)
     [false,setTopologyFromList(top2)]

   -- display
   coerce(x : %) : OutputForm ==
     x1:List SubTopology := x.topology
     msg:OutputForm := if x.basis then message "basis=" else message "topology="
     msg << bracket[(a::OutputForm) for a in x1]

   _=(a:%,b:%) : Boolean ==
     a=b

   getDimension(a : %) : NNI ==
     numEle:NNI := 0
     top1:List SubTopology := a.topology
     for x in top1 repeat
       if cardinality1(x)$SubTopology > numEle then numEle := cardinality1(x)$SubTopology
     numEle

   -- Given a set this function returns all its divisions that
   -- contain all elements.
   allDivisionsSetHelper(s:Record(result:List NNI,complement:List NNI)) : _
        List Record(result:List NNI,complement:List NNI) ==
     empty?(s.result) => [s]
     f : NNI := first (s.result)
     z : Record(result:List NNI,complement:List NNI) := [rest (s.result),cons(f,(s.complement))]
     p : List Record(result:List NNI,complement:List NNI) := allDivisionsSetHelper(z)
     res: List Record(result:List NNI,complement:List NNI) := copy p
     for x in p repeat
       c : List NNI := remove(f,x.complement)
       r : List NNI := cons(f,x.result)
       if r<c then
         y : Record(result:List NNI,complement:List NNI) := [r,c]
         res := cons(y,res)
     res

   -- Given a set this function returns all its divisions that
   -- contain all elements.
   allDivisionsSet(s1:List NNI) : List List List NNI ==
     s:Record(result:List NNI,complement:List NNI) := [s1,[]]
     r:List Record(result:List NNI,complement:List NNI) := allDivisionsSetHelper(s)
     res:List List List NNI := []
     for x in r repeat
       r1:List NNI := x.result
       c1:List NNI := x.complement
       if #r1 > 1
         then
           r2: List List List NNI := allDivisionsSet(r1)
           for r3 in r2 repeat
             r4: List List NNI := concat(r3,c1)
             -- print(message "allDivisionsSet r1=" << r1 << message " r2=" << r2 <<
             --       message " r3=" << r3 << message " r4=" << r4 << message " c1=" << c1)
             res := cons(r4,res)
         else
           if #r1=0
             then
               res := cons([c1],res)
             else
               res := cons([r1,c1],res)
     res

   -- Given a set this function returns all its subsets together with
   -- their complement.
   splitSet(s:Record(result:List NNI,complement:List NNI)) : _
        List Record(result:List NNI,complement:List NNI) ==
     empty?(s.result) => [s]
     f : NNI := first (s.result)
     z : Record(result:List NNI,complement:List NNI) := [rest (s.result),cons(f,(s.complement))]
     p : List Record(result:List NNI,complement:List NNI) := splitSet(z)
     res: List Record(result:List NNI,complement:List NNI) := copy p
     for x in p repeat
       c : List NNI := remove(f,x.complement)
       y : Record(result:List NNI,complement:List NNI) := [cons(f,x.result),c]
       res := cons(y,res)
     reverse res

   -- Construct a set of sub-topologies that covers a given space
   -- This is a cover for a given grade, built from the grade below it.
   -- Attempts to find smallest cover, but not guaranteed smallest as
   -- it does not do exhaustive search.
   allLattices(start:List NNI,finish:List NNI) : List PARTITION ==
     if empty?(finish) then return []
     p : Record(result:List NNI,complement:List NNI) := [finish,[]]
     ps : List Record(result:List NNI,complement:List NNI) := splitSet(p)
     res : List PARTITION := []
     for x in ps repeat
       r:List NNI := x.result
       d:List List List NNI := allDivisionsSet(reverse r)
       c:List NNI := x.complement
       for d2 in d repeat
         y:PARTITION := [d2,c]
         res := concat(res,y)
     res

   -- join 'a' and 'b'
   -- uses weak distributive rule
   joinEle(a:List List NNI,b:List List NNI) : List List List NNI ==
     if a=[] or a=[[]] then return [b]
     if b=[] or b=[[]] then return [a]
     res: List List List NNI := []
     for a1 in a repeat
       for b1 in b repeat
         a2:List List NNI := remove(a1,a)
         b2:List List NNI := remove(b1,b)
         d:List List NNI := [concat(a1,b1)]
         d := concat(a2,d)
         d := concat(b2,d)
         res := cons(d,res)
     -- print(message "joinEle a=" << a << message " b=" << b << message " res=" << reverse res)
     reverse res

   -- join 'a' to each element of vector
   joinVector(a:List List NNI,vec:List List List NNI) : List List List NNI ==
     if a=[] or a=[[]] then return vec
     res : List List List NNI := []
     for v in vec repeat
       res := concat(joinEle(a,v),res)
     res

   -- add 'a' to 'b'
   addEle(a:List List NNI,b:List List NNI) : List List NNI ==
     -- print(message "addEle a=" << a << message " b=" << b)
     if b=[] or b=[[]] then return []
     concat(a,b)

   -- add 'a' to each element of vector
   addVector(a:List List NNI,vec:List List List NNI) : List List List NNI ==
     if a=[] or a=[[]] then return []
     [addEle(a,v) for v in vec | not (v=[] or v=[[]])]

   nextVector(a:List List NNI,vec:List List List NNI) : List List List NNI ==
     res : List List List NNI := vec
     addv : List List List NNI := addVector(a,vec)
     joinv : List List List NNI := joinVector(a,vec)
     -- print(message "nextVector a=" << a << message " vec=" << vec <<
     --      message " addv=" << addv << message " joinv" << joinv)
     res := concat(addv,res)
     res := concat(joinv,res)
     res

   -- All sets of open sets where each element is included 0 or 1 times but
   -- not more.
   allSetsOfOpenSetsNoDuplicates(start:List NNI,finish:List NNI) : List List List NNI ==
     if #finish < 1 then return []
     res : List List List NNI := []
     for ele in finish repeat
       if empty? res
         then res := [[],[[ele]]]
         else res := nextVector([[ele]],res)
     res

   setSubtract(a : List NNI,b : List NNI) : List NNI ==
     res : List NNI := a
     for b1 in b repeat
       res := remove(b1,res)
     res

   -- Recursively called to construct a list of all possible topologies on that set.
   -- Parameters:
   -- topLevel - set of elements to construct over.
   -- bottom - bottom elements of this lattice.
   -- thisRemainder - open set containing elements yet to be covered
   -- subTopologyStack - A list of the subTopologys below this.
   allTopologies(level:NNI,topLevel : List NNI,bottom : List List NNI,thisRemainder : List NNI,
        subTopologyStack : List SubTopology,
        topologyStack : List List SubTopology) : List List SubTopology ==
     res:List List SubTopology := topologyStack
     all : List List List NNI := allSetsOfOpenSetsNoDuplicates([],thisRemainder)
     print(message "allTopologies level=" << level <<
           message " topLevel=" << topLevel <<
           message " bottom=" << bottom <<
           message " thisRemainder=" << thisRemainder <<
           message " subTopologyStack=" << subTopologyStack <<
           message " topologyStack=" << topologyStack <<
           message " all=" << all)
     for lattice in all repeat
       innerRes:List SubTopology := subTopologyStack
       if not lattice=[] then
         thisSL : SubTopology := subTopology(set bottom,set lattice)
         -- print(message "  thisSL=" << thisSL << message " lattice=" << lattice)
         thisTop : List NNI := top thisSL
         newRemainder : List NNI := setSubtract(topLevel,thisTop)
         innerRes := cons(thisSL,innerRes)
         if thisTop=topLevel
           then
             res := cons(reverse innerRes,res)
             -- print(message "  thisSL=" << thisSL << message " innerRes=" << innerRes)
           else
             allNodes : List List List NNI := allOpenLists thisSL
             for node in allNodes repeat
               if not node=[] then
                 target : List NNI := copy topLevel
                 for os in node repeat
                   target := setSubtract(target,os)
                 -- print(message "    node=" << node << message " target=" << target)
                 if (target=[] or (sort target)=topLevel)
                   then
                     innerRes := cons(thisSL,innerRes)
                   else
                     -- print(message "    bottom=" << bottom << message " thisTop=" << thisTop)
                     if level<3 then
                       res := allTopologies(level+1,topLevel,node,newRemainder,innerRes,res)
     res

   -- Given a set, construct a list of all possible topologies on that set
   -- Each of these topologies is made up from sub-topologies (complete lattices of open sets)
   -- that cover the space.
   -- Warning: This function can return very long lists, if the input set is 6 or
   -- more elements then the computer may run out of resources and crash.
   -- I have written an explanation of this algorithm on the web page here:
   -- https://www.euclideanspace.com/maths/topology/topologicalSpace/finite/extension/index.htm
   allTopologiesOnSet(topLevel : List NNI) : List % ==
     node : List List NNI := []
     subTopologyStack : List SubTopology := []
     topologyStack : List List SubTopology := []
     topologyStack := allTopologies(1,topLevel,node,topLevel,subTopologyStack,topologyStack)
     res : List % := []
     for x in topologyStack repeat
       t:% := topologyFinite2 x
       res := cons(t,res)
     res

)if false

   -- Given a set, construct a list of all possible topologies on that set
   -- Each of these topologies is made up from sub-topologies (complete lattices of open sets)
   -- that cover the space.
   -- Warning: This function can return very long lists, if the input set is 6 or
   -- more elements then the computer may run out of resources and crash.
   -- I have written an explanation of this algorithm on the web page here:
   -- https://www.euclideanspace.com/maths/topology/topologicalSpace/finite/extension/index.htm
   allTopologiesOnSet(topLevel : List NNI) : List % ==
     subTopologyStack : List SubTopology := []
     all : List List List NNI := allSetsOfOpenSetsNoDuplicates([],topLevel)
     print(message "allTopologiesOnSet all=" << all)
     res : List % := []
     for sl in all repeat
       thisSL : SubTopology := subTopology(set [],set sl)
       subTopologyStack := [thisSL]
       thisTop : List NNI := top thisSL
       thisRemainder : List NNI := setSubtract(topLevel,thisTop)
       if thisTop=topLevel
         then res := cons(topologyFinite2 [thisSL],res)
         else
           allNodes : List List List NNI := allOpenLists thisSL
           print(message "  thisSL=" << thisSL << message " allNodes=" << allNodes)
           for node in allNodes repeat
             if not node=[] then
               target : List NNI := copy topLevel
               for os in node repeat
                 target := setSubtract(target,os)
               print(message "    node=" << node << message " target=" << target)
               if (target=[] or (sort target)=topLevel)
                 then
                   res := cons(topologyFinite2 [thisSL],res)
                 else
                   subTopologyStack := allTopologies(topLevel,node,thisRemainder,subTopologyStack)
                   t:% := topologyFinite2 subTopologyStack
                   res := cons(t,res)
     res

)endif

