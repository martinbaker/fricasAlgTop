)abbrev domain TOPFIN TopologyFinite
++ Author: Martin Baker
++ Description:
++   A set of open sets.
++   Can also be thought of as a subset of the power set.
++   It may be sufficient to use only a basis where the full
++   topology can be reconstructed from it.
++   for more documentation see:
++ References:
++   https://www.euclideanspace.com/prog/scratchpad/mycode/topology/finite/

TopologyFinite() : Exports == Impl where
  NNI==> NonNegativeInteger
  x<<y ==> hconcat(x::OutputForm, y::OutputForm)

  Exports ==> SetCategory() with

    topologyFinite : (List List NNI) -> %
      ++ constructor

    topologyFiniteTrivial : () -> %
      ++ Constructor for trivial topology
      ++ Only empty(doesn't need to be explicitly included) and full open sets

    topologyFiniteDiscrete : (dim:NNI) -> %
      ++ Constructor for discrete topology
      ++ includes all open sets
      ++ Don't need to explicitly include empty

    topologyFiniteLeftOrder : (dim:NNI) -> %
      ++ Constructor for order topology
      ++ The order topology may be considered on partially ordered sets as
      ++ well as linearly ordered sets
      ++ The open sets are {x | x<b} where b is 1..max
      ++ On a linearly ordered set it coincides with the interval topology

    getTopology : (a:%) -> List List NNI

    full2basis : (a:%) -> %
      ++ Remove non-basis open sets
      ++ That is, for each element, only the smallest open set that includes it.

    basis2full : (a:%) -> %
      ++ Add all unions of open sets not already included

    coerce : (x : %) -> OutputForm
      ++ display as symbols

    intersection : (a:%, b:%) -> %

    union : (a:%, b:%) -> %
      ++ union with degenerates removed

    getDimension : (a : %) -> NNI

    product : (a : %, b : %) -> %

    nerveConstruction : (a : %) -> FiniteSimplicialComplex(Integer)
      ++ A nerve construction creates a simplicial complex with the
      ++ topological properties of a given set family.
      ++ The nerve construction is based on a cover of the set family
      ++ The resulting complex is a discrete representation of that cover.


  Impl ==> add

   -- A set and a topology on it.
   Rep := Record(basis:Boolean,topology:List (Set NNI))

   -- getTopologyAsList(t:List (Set NNI)) : List List NNI ==
   --   [getOpenSetAsList(a) for a in t]

   getTopology(a:%) : List List NNI ==
     t:List (Set NNI) := a.topology
     [members(a) for a in t]

   setTopologyFromList(t:List(List(NNI))) : List (Set NNI) ==
     [set(a) for a in t]

   -- constructor
   topologyFinite(a : List List NNI) : % ==
     [false,setTopologyFromList(a)]

   topologyFiniteTrivial() : % ==
     [false,empty]

   -- local function to add if new
   addIfNew(lst : List(List(NNI)), unsorted : List(NNI)) : List(List(NNI)) ==
       if empty?(unsorted) then return lst
       sorted : List(NNI) := sort(unsorted)
       if member?(sorted, lst) then return lst
       cons(sorted,lst)

   -- generate discrete topology
   genDiscreteTopology(lst : List(List(NNI)),level : NNI,
       thisOpenSet : List(NNI), dim : NNI) : List(List(NNI)) ==
     -- print(message "genDiscreteTopology(" << lst  << message ","
     --  << level  << message "," << thisOpenSet  << message "," << dim << message ")")
     top1:List List NNI := lst
     for i in 1..dim repeat
       openset1 : List NNI := [i]
       if not member?(i,thisOpenSet) then
         -- print(message "genDiscreteTopology not member(" << thisOpenSet  << message ","
         --   << i  << message ")")
         openset2 : List(NNI) := concat(thisOpenSet,openset1)
         if (level+1)<dim then
           top1 := genDiscreteTopology(top1,level+1,openset2,dim)
         top1 := addIfNew(top1,openset2)
     top1

   topologyFiniteDiscrete(dim:NNI) : % ==
     top1:List List NNI := empty
     top1 := genDiscreteTopology(top1,1,empty,dim)
     [false,setTopologyFromList(top1)]

   -- generate order topology
   genOrderTopology(lst : List(List(NNI)),level : NNI,
       thisOpenSet : List(NNI), dim : NNI) : List(List(NNI)) ==
     -- print(message "genOrderTopology(" << lst  << message ","
     --  << level  << message "," << thisOpenSet  << message "," << dim << message ")")
     top1:List List NNI := lst
     openset1:List NNI := []
     for i in 1..dim repeat
       -- print(message "genOrderTopology loop(" << top1  << message "," << i  << message ")")
       openset1 := cons(i,openset1)
       top1 := cons(openset1,top1)
     reverse top1

   -- generate order topology
   topologyFiniteLeftOrder(dim:NNI) : % ==
     top1:List List NNI := empty
     top1 := genOrderTopology(top1,1,empty,dim)
     [false,setTopologyFromList(top1)]

   -- To find a basis: for every element of the set find the smallest
   -- open set that contains it.
   -- Remove non-basis open sets
   -- That is, for each element, only the smallest open set that includes it.
   full2basis(a:%) : % ==
     -- assume number of elements is maximum index
     numEle:NNI := 0
     top1:List List NNI := getTopology(a)
     for x in top1 repeat
       for y in x repeat
         if y>numEle then numEle:=y
     basisSets:List List NNI := empty
     for currEle in 1..numEle repeat
       basisCandidate:List NNI := empty
       minSize:NNI := 0
       for currOpenSet in top1 repeat
         currSize:NNI := #currOpenSet
         if member?(currEle,currOpenSet) and not empty?(currOpenSet) and
          (minSize=0 or currSize < minSize) then
            --print(message "adding" << currOpenSet  << message " minSize="
            --  << minSize << message " currEle=" << currEle)
            basisCandidate := currOpenSet
            minSize := #currOpenSet
       basisSets := addIfNew(basisSets,basisCandidate)
     [true,setTopologyFromList(basisSets)]

   unionLocal(a:List NNI, b:List NNI) : List NNI ==
     res:List NNI := a
     for x in b repeat
       if not member?(x, res) then res:=cons(x,res)
     res

   -- Add all unions of open sets not already included
   basis2full(a:%) : % ==
     top1:List List NNI := getTopology(a)
     top2:List List NNI := copy(top1) -- so we dont alter top1 inside loop
     for x in top1 repeat
       for y in top1 repeat
         z : List NNI := sort (unionLocal(x,y))
         top2 := addIfNew(top2,z)
         -- print(message "x=" << x  << message " y="
         --  << y << message " union=" << z)
     [false,setTopologyFromList(top2)]

   -- display
   coerce(x : %) : OutputForm ==
     x1:List (Set NNI) := x.topology
     msg:OutputForm := if x.basis then message "basis=" else message "topology="
     msg << bracket[(a::OutputForm) for a in x1]

   "="(a:%,b:%) : Boolean ==
     a=b

   -- intersection
   intersection(a:%, b:%) : % ==
     -- sort(setIntersection(a,b))
     a

   -- union with degenerates removed
   union(a:%, b:%) : % ==
     -- removeDuplicates!(merge("<",a,b))
     a

   getDimension(a : %) : NNI ==
     numEle:NNI := 0
     top1:List (Set NNI) := a.topology
     for x in top1 repeat
       if cardinality(x)$(Set NNI) > numEle then numEle := cardinality(x)$(Set NNI)
     numEle

   shift(a : Set NNI, distance : NNI) : Set NNI ==
     set [x+distance for x in members(a)]

   productOfSets(a : Set NNI, b : Set NNI) : Set NNI ==
     -- should check that a and b are disjoint
     union(a,b)

   product(a : %, b : %) : % ==
     top1:List (Set NNI) := (full2basis a).topology
     top2:List (Set NNI) := (full2basis b).topology
     -- following only works for full not basis
     sizea:NNI := getDimension(a)
     sizeb:NNI := getDimension(a)
     top2s:List (Set NNI) := [shift(x,sizea) for x in top2]
     res:List (Set NNI) := empty
     for x in top1 repeat
       for y in top2s repeat
         res := cons(productOfSets(x,y),res)
     [true,res]

   -- local function to add if new
   addIfNew2(lst : List(Set(NNI)), unsorted : Set(NNI)) : List(Set(NNI)) ==
       if empty?(unsorted) then return lst
       -- sorted : Set(NNI) := sort(unsorted)
       if member?(unsorted, lst) then return lst
       cons(unsorted,lst)

   -- https://sauln.github.io/blog/towers-nerves/
   -- A nerve construction creates a simplicial complex with the
   -- topological properties of a given set family.
   -- The nerve construction is based on a cover of the set family
   -- The resulting complex is a discrete representation of that cover.
   nerveConstruction(a : %) : FiniteSimplicialComplex(Integer) ==
     -- For each nonempty intersection of n elements in the cover,
     -- add an (n-1)-dimensional simplex.
     top1:List (Set NNI) := (a::Rep).topology
     intersections:List (Set NNI) := empty
     for x in top1 repeat
       for y in top1 repeat
         intersec:(Set NNI) := intersect(x,y)
         intersections := addIfNew2(intersections,intersec)
         -- print(message "x=" << x  << message " y="
         --    << y << message " intersec=" << intersec)
     -- print(message "intersections=" << intersections )
     -- Add a vertex for each element in the cover.
     -- Add an edge between two vertices if the corresponding sets overlap.
     leng:NNI := #intersections
     eles:List Integer := [x for x in 1..leng]
     top1:List List NNI := [members(a) for a in intersections]
     simplicialComplex(eles,top1)

)abbrev domain TOPOSP TopoSpaceFinite
++ Author: Martin Baker
++ Description:
++   TopoSpaceFinite topological space as set + opensets.
++   for more documentation see:
++ References:
++   https://www.euclideanspace.com/prog/scratchpad/mycode/topology/finite/

TopoSpaceFinite(S : SetCategory) : Exports == Impl where
  NNI==> NonNegativeInteger
  x<<y ==> hconcat(x::OutputForm, y::OutputForm)

  Exports ==> SetCategory() with

    topologyFinite : (List Symbol) -> %
      ++ constructor

    topoSpaceFiniteTrivial : (List String) -> %
      ++ Constructor for trivial topology
      ++ Only empty and full open sets (don't need to be explicitly included)

    topoSpaceFiniteDiscrete : (List String) -> %
      ++ Constructor for discrete topology
      ++ includes all open sets
      ++ Don't need to explicitly include empty and full set

    topoSpaceFiniteLeftOrder : (List String) -> %
      ++ Constructor for order topology
      ++ The order topology may be considered on partially ordered sets as
      ++ well as linearly ordered sets
      ++ The open sets are {x | x<b} where b is 1..max
      ++ On a linearly ordered set it coincides with the interval topology

    coerce : (x : %) -> OutputForm
      ++ display as symbols

    getTopology : (x : %) -> TopologyFinite

    getTopologyToList : (x : %) -> List List NNI

    product : (a : %, b : %) -> %
      ++ The product topology is the coarsest topology (the topology
      ++ with the fewest open sets) which still has continuous projections
      ++ to the input topologies.

    nerveConstruction : (a : %) -> FiniteSimplicialComplex(Integer)
      ++ A nerve construction creates a simplicial complex with the
      ++ topological properties of a given set family.
      ++ The nerve construction is based on a cover of the set family
      ++ The resulting complex is a discrete representation of that cover.

  Impl ==> add

   -- A set and a topology on it.
   Rep := Record(topSet : List S, topol : TopologyFinite)

   getTopology(x : %) : TopologyFinite ==
     x.topol

   getTopologyToList(x : %) : List List NNI ==
     getTopology(x.topol)

   -- constructor
   topoSpaceFinite(a : List S) : % ==
     [a,topologyFiniteTrivial()]

   if S is Symbol then topoSpaceFiniteTrivial(x1 : List String) : % ==
     [[a::Symbol for a in x1],topologyFiniteTrivial()]

   -- local function to add if new
   addIfNew(lst : List(List(NNI)), unsorted : List(NNI)) : List(List(NNI)) ==
       if empty?(unsorted) then return lst
       sorted : List(NNI) := sort(unsorted)
       if member?(sorted, lst) then return lst
       cons(sorted,lst)

   if S is Symbol then topoSpaceFiniteDiscrete(x1 : List String) : % ==
     dim1:NNI := #x1
     [[a::Symbol for a in x1],topologyFiniteDiscrete(dim1)]

   -- generate order topology
   if S is Symbol then topoSpaceFiniteLeftOrder(x1 : List String) : % ==
     dim1:NNI := #x1
     [[a::Symbol for a in x1],topologyFiniteLeftOrder(dim1)]

   -- display as symbols
   coerce(x : %) : OutputForm ==
     x1:List S := x.topSet
     topSet1:OutputForm := bracket[a::OutputForm for a in x1]
     bracket[topSet1,(x.topol)::OutputForm]

   "="(a:%,b:%) : Boolean ==
     a=b

   -- The product topology is the coarsest topology (the topology
   -- with the fewest open sets) which still has continuous projections
   -- to the input topologies.
   product(a : %, b : %) : % ==
     a1:List S := a.topSet
     b1:List S := b.topSet
     -- convert inputs to basis
     a2:TopologyFinite := full2basis(a.topol)
     b2:TopologyFinite := full2basis(b.topol)
     -- Cartesian product of sets
     pairs:List(Record(left : S, right : S)) := empty
     for sa in a1 repeat
       for sb in b1 repeat
         pair:Record(left : S, right : S) := [sa,sb]
         pairs := cons(pair,pairs)
     print(message "points=" << pairs)
     topols:List(Record(tl : List(NNI), tr : List(NNI))) := empty
     for ta in getTopology(a2) repeat
       for tb in getTopology(b2) repeat
         topol:Record(tl : List(NNI), tr : List(NNI)) := [ta,tb]
         topols := cons(topol,topols)
     print(message "topols=" << topols)
     [a1,a2]

   -- https://sauln.github.io/blog/towers-nerves/
   -- A nerve construction creates a simplicial complex with the
   -- topological properties of a given set family.
   -- The nerve construction is based on a cover of the set family
   -- The resulting complex is a discrete representation of that cover.
   nerveConstruction(a : %) : FiniteSimplicialComplex(Integer) ==
     -- For each nonempty intersection of n elements in the cover,
     -- add an (n-1)-dimensional simplex.
     a1:TopologyFinite := a.topol
     nerveConstruction(a1)

)abbrev domain CONTMAP ContinuousMap
++ Author: Martin Baker
++ Description:
++   A continuous map between two topological spaces
++   for more documentation see:
++ References:
++   https://www.euclideanspace.com/prog/scratchpad/mycode/topology/finite/

ContinuousMap(DOMAIN:TopoSpaceFinite(Symbol),CODOMAIN:TopoSpaceFinite(Symbol)) : Exports == Impl where
  NNI==> NonNegativeInteger
  x<<y ==> hconcat(x::OutputForm, y::OutputForm)

  Exports ==> SetCategory() with

    -- for now just use NNI indexes, later may generalise like this:
    -- continuousMap : (im:Table(NNI,NNI),preIm:Table(NNI,NNI)) -> %
    continuousMap : (im:List NNI) -> %
      ++ Construct from only image and reconstuct pre-image
    continuousMap : (im:List NNI,preIm:List NNI) -> %
      ++ Construct given image and pre-image

    getContents : (x : %) -> Record(image:List NNI,preImage:List NNI)

  Impl ==> add

   -- image: a map of the points in the forward direction.
   -- preImage: a map of the open sets in the reverse direction.
   -- for now just use NNI indexes, later may generalise like this:
   -- Rep := Record(image:Table(NNI,NNI),preImage:Table(NNI,NNI))
   Rep := Record(image:List NNI,preImage:List NNI)

   -- constructor
   continuousMap(im:List NNI) : % ==
     t1 :List List NNI := getTopologyToList(DOMAIN)
     t2 :List List NNI := getTopologyToList(CODOMAIN)
     -- print (message "top in=" << t1 << message " top out=" << t2 << message " im=" << im)
     preImMap:List NNI := []
     -- for every open set in the codomain
     for os in t2 repeat
       currentPreIm:List NNI := []
       -- for every point p in the codomain i is its preimage
       for p in im for i in 1..(#im) repeat
         if member?(p,os) then
           if not member?(i,currentPreIm) then
             currentPreIm := cons(i,currentPreIm)
       -- print (message "  os=" << os << message " preIm=" << currentPreIm)
       sortedPreIm:List NNI := sort currentPreIm
       if entry?(sortedPreIm,t1)
         then
           -- print (message " open set:=" << sortedPreIm << message " is in domain")
           preImMap := cons(qcoerce(position(sortedPreIm,t1)),preImMap)
         else
           print (message " open set:=" << sortedPreIm << message " not in domain")
           error "invalid continuous map"
     [im,preImMap]

   -- constructor
   continuousMap(im:List NNI,preIm:List NNI) : % ==
     if empty?(preIm) then return continuousMap(im)
     [im,preIm]

   getContents(x : %) : Record(image:List NNI,preImage:List NNI) ==
     x::Rep

   coerce(x : %) : OutputForm ==
     x1:List NNI := (x.image)
     x2:List NNI := (x.preImage)
     message "map image=" << bracket [a::OutputForm for a in x1] <<
       message " preimage=" << bracket [a::OutputForm for a in x2]

)abbrev domain HOMSET Homset
++ Author: Martin Baker
++ Description:
++   A set of continuous maps between two topological spaces
++   may be a homotopy
++   for more documentation see:
++ References:
++   https://www.euclideanspace.com/prog/scratchpad/mycode/topology/finite/

Homset(DOMAIN:TopoSpaceFinite(Symbol),CODOMAIN:TopoSpaceFinite(Symbol)) : Exports == Impl where
  NNI==> NonNegativeInteger
  x<<y ==> hconcat(x::OutputForm, y::OutputForm)

  Exports ==> SetCategory() with

    allMaps:(maxDomain:NNI,maxCodomain:NNI) -> List List NNI

    homset : () -> %
      ++ Multiple possible maps from only images and reconstuct pre-images

  Impl ==> add

   -- image: a map of the points in the forward direction.
   -- preImage: a map of the open sets in the reverse direction.
   Rep := List Record(image:List NNI,preImage:List NNI)

   incrementImage(im:List NNI,pos:NNI,maxDomain:NNI,maxCodomain:NNI) : List NNI ==
     if empty?(im) then return im
     val:NNI := elt(im,pos)
     imCopy:List NNI := copy im
     if val < maxDomain then
       setelt!(imCopy,pos,val+1)
       return imCopy
     setelt!(imCopy,pos,1)
     if pos+1 > maxCodomain then return []
     incrementImage(imCopy,pos+1,maxDomain,maxCodomain)

   -- local function to generate all possible maps
   allMaps(maxDomain:NNI,maxCodomain:NNI) : List List NNI ==
     currentDomain:NNI := 1
     currentCodomain:NNI := 1
     im:List NNI := [1 for ignore in 1..maxDomain]
     res: List List NNI := [copy im]
     -- print (message "allMaps1 im:" << im << message " currentDomain:" << currentDomain <<
     --   message " currentCodomain:" <<  currentCodomain)
     while true repeat
       im := incrementImage(im,1,maxCodomain,maxDomain)
       if empty?(im) then return res
       res:= cons(im,res)
     res

   preImageFromImage(im:List NNI) : List NNI ==
     t1 :List List NNI := getTopologyToList(DOMAIN)
     t2 :List List NNI := getTopologyToList(CODOMAIN)
     -- print (message "preImage: top in=" << t1 << message " top out=" << t2 << message " im=" << im)
     preImMap:List NNI := []
     -- for every open set in the codomain
     for os in t2 repeat
       currentPreIm:List NNI := []
       -- for every point p in the codomain i is its preimage
       for p in im for i in 1..(#im) repeat
         if member?(p,os) then
           if not member?(i,currentPreIm) then
             currentPreIm := cons(i,currentPreIm)
       -- print (message "  preImage: os=" << os << message " preIm=" << currentPreIm)
       sortedPreIm:List NNI := sort currentPreIm
       if entry?(sortedPreIm,t1)
         then
           -- print (message " preImage: open set:=" << sortedPreIm << message " is in domain")
           preImMap := cons(qcoerce(position(sortedPreIm,t1)),preImMap)
         else
           -- print (message " preImage: open set:=" << sortedPreIm << message " not in domain")
           return []
     preImMap

   -- constructor
   homset() : % ==
     maxDomain:NNI := #getTopologyToList(DOMAIN) -- number of points in domain
     maxCodomain:NNI := #getTopologyToList(CODOMAIN) -- number of points in codomain
     -- print (message "homset: domain=" << getTopologyToList(DOMAIN) << message " size=" << #getTopologyToList(DOMAIN))
     -- print (message "homset: codomain=" << getTopologyToList(CODOMAIN) << message " size=" << #getTopologyToList(CODOMAIN))
     all : List List NNI := allMaps(maxDomain,maxCodomain)
     -- print (message "homset: all=" << all)
     res : List Record(image:List NNI,preImage:List NNI) := []
     for im in all repeat
       pm : List NNI := preImageFromImage(im)
       -- print (message " next image:" << im << message " preimage:" << pm)
       if not empty?(pm) then
         -- print (message "not empty")
         currentRep : Record(image:List NNI,preImage:List NNI) := [im,pm]
         res := cons(currentRep,res)
     res

   outputOneEntry(x : Record(image:List NNI,preImage:List NNI)) : OutputForm ==
     x1:List NNI := (x.image)
     x2:List NNI := (x.preImage)
     message "map image=" << bracket [a::OutputForm for a in x1] <<
       message " preimage=" << bracket [a::OutputForm for a in x2]

   coerce(x : %) : OutputForm ==
     message "homset" << bracket[outputOneEntry(a) for a in x]
