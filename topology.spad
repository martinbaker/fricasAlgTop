-- b := toOpenSets(allTopologiesAsLattice [1,2],[1,2])
-- compareTopologies(a, b)
--
-- validateTopologyList(allTopologiesOnSet [1,2,3,4],4)
--
-- test TopologyFinite
-- y1 := topologyFiniteLeftOrder(3)
-- y2 := topologyFiniteDiscrete(3)
-- y3 := full2basis y2
-- y4 := basis2full y3
-- product(y1,y2)
--
-- test TopoSpaceFinite
-- ts1 := topoSpaceFiniteTrivial(["a","b"]) $ TopoSpaceFinite Symbol
-- ts2 := topoSpaceFiniteDiscrete(["a","b","c"]) $ TopoSpaceFinite Symbol
-- ts3 := topoSpaceFiniteLeftOrder(["a","b","c"]) $ TopoSpaceFinite Symbol
-- ts4 := topoSpaceFiniteLeftOrder(["d","e"]) $ TopoSpaceFinite Symbol
-- product(ts3,ts4)
-- nerveConstruction(ts3)
--
-- test maps
-- source := topoSpaceFiniteLeftOrder(["a","b","c"]) $ TopoSpaceFinite Symbol
-- target := topoSpaceFiniteLeftOrder(["d","e"]) $ TopoSpaceFinite Symbol
-- map := continuousMap([1,2,2],[]) $ ContinuousMap(source,target)
-- map := continuousMap([2,1,2],[]) $ ContinuousMap(source,target)
--
-- test homsets
-- source := topoSpaceFiniteLeftOrder(["a","b","c"])
-- target := topoSpaceFiniteLeftOrder(["d","e"])
-- h := homset() $ Homset(source,target)

-- To run this code on FriCAS first install and run the  FriCAS code as described on
-- https://fricas.sourceforge.net/download.html
-- Then compile this code:
-- )co fricas/topology.spad
--
-- Here are some things to test the code:
--
-- allTopologiesAsLattice [1,2,3]
-- validateAll(allTopologiesAsLattice [1,2,3])
-- 0 : 1
-- 1 : 1
-- 2 : 4
-- 3 : 29
-- 4 : 355
-- 5 : 6942
-- 6 : 209527
-- 7 : 9535241
-- 8 : 642779354
-- 9 : 63260289423
-- 10: 8977053873043
-- toOpenSets allTopologiesAsLattice [1,2,3]
-- allLatticesNoRepeatedElements([1,2,3],subLattice([],[]),true)
-- allLatticesNoRepeatedElements([4,5],subLattice([1],[[2],[3]]),true)
-- allLatticesNoRepeatedElements([4],subLattice([1],[[2],[3]]),true)
-- b := subLattice([1],[[2,3]]) -- 1*P{2\/3}
-- b := subLattice([1],[[2],[3]]) -- 1*P{2+3}
-- existingSupersets([2],b)
-- cc1 := allLattices([1,2,3])
-- allDivisionsSet([1,2,3])
--
-- )set output length 245
-- allTopologiesAsLattice [1,2,3,4]
--
-- )trace TopologyLattice )ops allTopologiesAsLattice )timer )nt
-- Packages traced:
--    TopologyLattice
-- Parameterized constructors traced:
--    TOPFIN
-- (26) -> allTopologiesAsLattice [1,2,3]
-- (29) -> )trace )stats
--------------------- Traced function execution times ----------------------
-- TopologyLattice.allTopologiesAsLattice,67 : 0.001 sec.


)abbrev domain TOPFIN TopologyFinite
++ Author: Martin Baker
++ Description:
++   A set of open sets.
++   Can also be thought of as a subset of the power set.
++   It may be sufficient to use only a basis where the full
++   topology can be reconstructed from it.
++   for more documentation see:
++ References:
++   https://www.euclideanspace.com/prog/scratchpad/mycode/topology/finite/

TopologyFinite() : Exports == Impl where
  NNI==> NonNegativeInteger
  x<<y ==> hconcat(x::OutputForm, y::OutputForm)

  Exports ==> SetCategory() with

    topologyFinite : (List List NNI) -> %
      ++ constructor

    topologyFiniteTrivial : () -> %
      ++ Constructor for trivial topology
      ++ Only empty(doesn't need to be explicitly included) and full open sets

    topologyFiniteDiscrete : (dim:NNI) -> %
      ++ Constructor for discrete topology
      ++ includes all open sets
      ++ Don't need to explicitly include empty

    topologyFiniteLeftOrder : (dim:NNI) -> %
      ++ Constructor for order topology
      ++ The order topology may be considered on partially ordered sets as
      ++ well as linearly ordered sets
      ++ The open sets are {x | x<b} where b is 1..max
      ++ On a linearly ordered set it coincides with the interval topology

    validateTopology : (a:%,maxDegree:NNI) -> Boolean
      ++ check this topology has all meets and joins

    validateTopologyList : (a:List %,maxDegree:NNI) -> Boolean
      ++ check this topology has all meets and joins
      ++ also check for duplicates

    getTopology : (a:%) -> List List NNI
      ++ returns open sets as list of list

    getOpenSets : (a:%) -> List Set NNI
      ++ returns open sets as list of set

    full2basis : (a:%) -> %
      ++ Remove non-basis open sets
      ++ That is, for each element, only the smallest open set that includes it.

    basis2full : (a:%) -> %
      ++ Add all unions of open sets not already included

    coerce : (x : %) -> OutputForm
      ++ display as symbols

    intersection : (a:%, b:%) -> %

    union : (a:%, b:%) -> %
      ++ union with degenerates removed

    compareTopologies : (a:List %, b:List %) -> Boolean

    getDimension : (a : %) -> NNI

    product : (a : %, b : %) -> %

    powerSetGradedOld : (d:NNI,grade:NNI) -> List List NNI

    nerveConstruction : (a : %) -> FiniteSimplicialComplex(Integer)
      ++ A nerve construction creates a simplicial complex with the
      ++ topological properties of a given set family.
      ++ The nerve construction is based on a cover of the set family
      ++ The resulting complex is a discrete representation of that cover.

    testValidTopol : (allDegree:List List NNI,degree:NNI) -> Boolean

    allTopologiesOnSet : (s : List NNI) -> List %
      ++ Given a set construct a list of all possible topologies on that set
      ++ Warning: This function can return very long lists, if the input set is 6 or
      ++ more elements then the computer may run out of resources and crash.
      ++ I have written an explanation of this algorithm on the web page here:
      ++ https://www.euclideanspace.com/maths/topology/topologicalSpace/finite/all/index.htm

    countAllTopologiesOnSet : (s : List NNI) -> NNI
      ++ Given a set count all possible topologies on that set


  Impl ==> add

   -- A topology on a finite set.
   -- Defined by a list of open sets. Elements are labelled by a NNI number.
   Rep := Record(basis:Boolean,topology:List (Set NNI))

   -- getTopologyAsList(t:List (Set NNI)) : List List NNI ==
   --   [getOpenSetAsList(a) for a in t]

   getTopology(a:%) : List List NNI ==
     t:List (Set NNI) := a.topology
     [members(a) for a in t]

   -- returns open sets as list of set
   getOpenSets(a:%) : List Set NNI ==
     a.topology

   setTopologyFromList(t:List(List(NNI))) : List (Set NNI) ==
     [set(a) for a in t]

   -- constructor
   topologyFinite(a : List List NNI) : % ==
     [false,setTopologyFromList(a)]

   topologyFiniteTrivial() : % ==
     [false,empty]

   -- local function to add if new
   addIfNew(lst : List(List(NNI)), unsorted : List(NNI)) : List(List(NNI)) ==
       if empty?(unsorted) then return lst
       sorted : List(NNI) := sort(unsorted)
       if member?(sorted, lst) then return lst
       cons(sorted,lst)

   -- generate discrete topology
   genDiscreteTopology(lst : List(List(NNI)),level : NNI,
       thisOpenSet : List(NNI), dim : NNI) : List(List(NNI)) ==
     -- print(message "genDiscreteTopology(" << lst  << message ","
     --  << level  << message "," << thisOpenSet  << message "," << dim << message ")")
     top1:List List NNI := lst
     for i in 1..dim repeat
       openset1 : List NNI := [i]
       if not member?(i,thisOpenSet) then
         -- print(message "genDiscreteTopology not member(" << thisOpenSet  << message ","
         --   << i  << message ")")
         openset2 : List(NNI) := concat(thisOpenSet,openset1)
         if (level+1)<dim then
           top1 := genDiscreteTopology(top1,level+1,openset2,dim)
         top1 := addIfNew(top1,openset2)
     top1

   topologyFiniteDiscrete(dim:NNI) : % ==
     top1:List List NNI := empty
     top1 := genDiscreteTopology(top1,1,empty,dim)
     [false,setTopologyFromList(top1)]

   -- generate order topology
   genOrderTopology(lst : List(List(NNI)),level : NNI,
       thisOpenSet : List(NNI), dim : NNI) : List(List(NNI)) ==
     -- print(message "genOrderTopology(" << lst  << message ","
     --  << level  << message "," << thisOpenSet  << message "," << dim << message ")")
     top1:List List NNI := lst
     openset1:List NNI := []
     for i in 1..dim repeat
       -- print(message "genOrderTopology loop(" << top1  << message "," << i  << message ")")
       openset1 := cons(i,openset1)
       top1 := cons(openset1,top1)
     reverse top1

   -- generate order topology
   topologyFiniteLeftOrder(dim:NNI) : % ==
     top1:List List NNI := empty
     top1 := genOrderTopology(top1,1,empty,dim)
     [false,setTopologyFromList(top1)]

   -- check this topology has all meets and joins
   validateTopology(a:%,maxDegree:NNI) : Boolean ==
     top1:List Set NNI := getOpenSets(a)
     if empty?(top1) then return true
     for os1 in top1 repeat
       for os2 in top1 repeat
         join:Set NNI := union(os1,os2)
         meet:Set NNI := intersect(os1,os2)
         if not empty?(meet) then
           if not member?(meet,top1) then
             print(message "validateTopology invalid:" << top1)
             print(message " os1=" << os1 << message " os2=" << os2)
             print(message " meet=" << meet)
             return false
     true

   -- check this topology has all meets and joins
   -- also check for duplicates
   validateTopologyList(a:List %,maxDegree:NNI) : Boolean ==
     for topol in a repeat
       if not validateTopology(topol,maxDegree) then
         print(message "validateTopologyList invalid:" << topol)
         return false
     true


   compareTopologies(a:List %, b:List %) : Boolean ==
     equalTop : Boolean := true
     print(message "compareTopologies In b but not in a:" << 1)
     for x in a repeat
       if not member?(x,b) then
         print(message "diff:" << x)
         equalTop := false
     print(message "compareTopologies In a but not in b:" << 2)
     for y in b repeat
       if not member?(y,a) then
         print(message "diff:" << y)
         equalTop := false
     equalTop

   -- To find a basis: for every element of the set find the smallest
   -- open set that contains it.
   -- Remove non-basis open sets
   -- That is, for each element, only the smallest open set that includes it.
   full2basis(a:%) : % ==
     -- assume number of elements is maximum index
     numEle:NNI := 0
     top1:List List NNI := getTopology(a)
     for x in top1 repeat
       for y in x repeat
         if y>numEle then numEle:=y
     basisSets:List List NNI := empty
     for currEle in 1..numEle repeat
       basisCandidate:List NNI := empty
       minSize:NNI := 0
       for currOpenSet in top1 repeat
         currSize:NNI := #currOpenSet
         if member?(currEle,currOpenSet) and not empty?(currOpenSet) and
          (minSize=0 or currSize < minSize) then
            --print(message "adding" << currOpenSet  << message " minSize="
            --  << minSize << message " currEle=" << currEle)
            basisCandidate := currOpenSet
            minSize := #currOpenSet
       basisSets := addIfNew(basisSets,basisCandidate)
     [true,setTopologyFromList(basisSets)]

   unionLocal(a:List NNI, b:List NNI) : List NNI ==
     res:List NNI := a
     for x in b repeat
       if not member?(x, res) then res:=cons(x,res)
     res

   -- Add all unions of open sets not already included
   basis2full(a:%) : % ==
     top1:List List NNI := getTopology(a)
     top2:List List NNI := copy(top1) -- so we dont alter top1 inside loop
     for x in top1 repeat
       for y in top1 repeat
         z : List NNI := sort (unionLocal(x,y))
         top2 := addIfNew(top2,z)
         -- print(message "x=" << x  << message " y="
         --  << y << message " union=" << z)
     [false,setTopologyFromList(top2)]

   -- display
   coerce(x : %) : OutputForm ==
     x1:List (Set NNI) := x.topology
     msg:OutputForm := if x.basis then message "basis=" else message "topology="
     msg << bracket[(a::OutputForm) for a in x1]

   -- _=(a:%,b:%) : Boolean ==
   --   a.topology = b.topology

   _=(a:%, b:%) : Boolean ==
     equalTop : Boolean := true
     topA:List Set NNI := getOpenSets(a)
     topB:List Set NNI := getOpenSets(b)
     -- print(message "= In b but not in a:" << 1)
     for x in topA repeat
       if not member?(x,topB) then
         -- print(message "diff:" << x << message " not in " << topB)
         equalTop := false
     -- print(message "= In a but not in b:" << 2)
     for y in topB repeat
       if not member?(y,topA) then
         -- print(message "diff:" << y << message " not in " << topA)
         equalTop := false
     equalTop

   -- intersection
   intersection(a:%, b:%) : % ==
     -- sort(setIntersection(a,b))
     a

   -- union with degenerates removed
   union(a:%, b:%) : % ==
     -- removeDuplicates!(merge("<",a,b))
     a

   getDimension(a : %) : NNI ==
     numEle:NNI := 0
     top1:List (Set NNI) := a.topology
     for x in top1 repeat
       if cardinality(x)$(Set NNI) > numEle then numEle := cardinality(x)$(Set NNI)
     numEle

   shift(a : Set NNI, distance : NNI) : Set NNI ==
     set [x+distance for x in members(a)]

   productOfSets(a : Set NNI, b : Set NNI) : Set NNI ==
     -- should check that a and b are disjoint
     union(a,b)

   product(a : %, b : %) : % ==
     top1:List (Set NNI) := (full2basis a).topology
     top2:List (Set NNI) := (full2basis b).topology
     -- following only works for full not basis
     sizea:NNI := getDimension(a)
     sizeb:NNI := getDimension(a)
     top2s:List (Set NNI) := [shift(x,sizea) for x in top2]
     res:List (Set NNI) := empty
     for x in top1 repeat
       for y in top2s repeat
         res := cons(productOfSets(x,y),res)
     [true,res]

   -- local function to add if new
   addIfNew2(lst : List(Set(NNI)), unsorted : Set(NNI)) : List(Set(NNI)) ==
       if empty?(unsorted) then return lst
       -- sorted : Set(NNI) := sort(unsorted)
       if member?(unsorted, lst) then return lst
       cons(unsorted,lst)

   -- https://sauln.github.io/blog/towers-nerves/
   -- A nerve construction creates a simplicial complex with the
   -- topological properties of a given set family.
   -- The nerve construction is based on a cover of the set family
   -- The resulting complex is a discrete representation of that cover.
   nerveConstruction(a : %) : FiniteSimplicialComplex(Integer) ==
     -- For each nonempty intersection of n elements in the cover,
     -- add an (n-1)-dimensional simplex.
     top1:List (Set NNI) := (a::Rep).topology
     intersections:List (Set NNI) := empty
     for x in top1 repeat
       for y in top1 repeat
         intersec:(Set NNI) := intersect(x,y)
         intersections := addIfNew2(intersections,intersec)
         -- print(message "x=" << x  << message " y="
         --    << y << message " intersec=" << intersec)
     -- print(message "intersections=" << intersections )
     -- Add a vertex for each element in the cover.
     -- Add an edge between two vertices if the corresponding sets overlap.
     leng:NNI := #intersections
     eles:List Integer := [x for x in 1..leng]
     top1:List List NNI := [members(a) for a in intersections]
     simplicialComplex(eles,top1)

   subset(li:List NNI, n:NNI) : List NNI ==
     [x for x in li for i in 0..#li-1 | bit?(n, i)]

   powerSet(s:List NNI) : List List NNI ==
     empty? s => [s]
     concat(p:=powerSet(rest s),[cons(first s,x) for x in p])

   powerSetOfLists(s:List List NNI) : List List List NNI ==
     empty? s => [s]
     -- print(message "powerSetOfLists=" << s )
     p:=powerSetOfLists(rest s)
     concat(p,[cons(first s,x) for x in p])

   -- Return all combinations of k from n
   -- example:
   -- if k=1 and n=3 then return [{1}],[{2}],[{3}]]
   kFromNCombinations(k1:NNI,n1:NNI) : List List NNI ==
     n:Integer := n1
     k:Integer := k1
     r : List List Integer :=
       [reverse subSet(n,k,i)$SymmetricGroupCombinatoricFunctions for
         i in 0..binomial(n,k)-1]
     [[(y+1)::NNI for y in x] for x in r]

   -- Return combinations of all combinations of k from n
   -- if k=1 and n=3  then return [{1}],[{2}],[{3}],[{1},{2}] ... [{1},{2},{3}]
   kFromNCombComb(k1:NNI,n1:NNI) : List List List NNI ==
     powerSetOfLists(kFromNCombinations(k1,n1))

   grade(s:List List NNI,x:NNI) : List List NNI ==
     empty? s => s
     reverse [os for os in s | #os=x]

   listMeet(os:List NNI,os2:List NNI) : List NNI ==
     res: List NNI := []
     for e in os repeat
       for e2 in os2 repeat
         if e=e2 then res:=cons(e,res)
     if empty? res then return res
     sort res

   listJoin(os:List NNI,os2:List NNI) : List NNI ==
     res: List NNI := []
     for e in os repeat
       if not entry?(e,res) then res:=cons(e,res)
     for e in os2 repeat
       if not entry?(e,res) then res:=cons(e,res)
     if empty? res then return res
     sort res

   -- Return value indicates if the topology is valid upto the degree so far.
   -- degree 1 (singletons) contains combinations of open sets like [[1],[2]] etc.
   -- degree 2 contains combinations of open sets like [[1,2],[2,3]] etc.
   -- and so on.
   -- Even if this returns 'true' there may be higher degree open sets still required.
   -- (only checks downward)
   -- parameter 'allDegree' holds a possible topology which is valid upto the degree below
   -- returns true if these are compatible
   testValidTopol(allDegree:List List NNI,
                  degree:NNI) : Boolean ==
     -- For a valid topology all joins and meets must exist
     for x in allDegree for i in 1.. repeat
       for y in allDegree for i2 in 1.. repeat
         if i2>i then
           osJoin:List NNI := listJoin(x,y)
           if #osJoin <= degree then -- can only check upto this degree
             if not entry?(osJoin,allDegree) then
               return false
           osMeet:List NNI := listMeet(x,y)
           if not osMeet=[] then
             if not entry?(osMeet,allDegree) then
               return false
     true

   -- Given all potential topologies containing upto 'degree-1' open sets add
   -- 'degree' open sets then call recursivly until we get to 'maxDegree'.
   -- parameter 's' is all potential topologies containing only upto 'degree-1' open sets.
   -- degree 1 (singletons) contains combinations of open sets like [[1],[2]] etc.
   -- degree 2 contains combinations of open sets like [[1,2],[2,3]] etc. with degree 1
   -- and so on.
   allTopologiesRecursive(allDegree : List List NNI,
                          degree:NNI,maxDegree:NNI) : List % ==
     degree = maxDegree => [topologyFinite allDegree]
     -- only at top degree are we sure we have valid topology
     -- 'thisLevel' will hold all possible combinations of open sets for this degree
     thisLevel:List List List NNI := kFromNCombComb(degree,maxDegree)
     allValidTopol:List % := []
     for topolAtLevel in thisLevel repeat
       allDegreeSoFar : List List NNI :=
         if topolAtLevel=[[]]
           then allDegree
           else
             if allDegree=[[]]
               then topolAtLevel
               else concat(topolAtLevel,allDegree);
       if testValidTopol(allDegreeSoFar,degree) then
         validTopol : List % :=
           allTopologiesRecursive(allDegreeSoFar,
                          degree+1,maxDegree)
         allValidTopol := concat(validTopol,allValidTopol)
     allValidTopol

   -- Given a set, construct a list of all possible topologies on that set
   -- Warning: This function can return very long lists, if the input set is 6 or
   -- more elements then the computer may run out of resources and crash.
   -- I have written an explanation of this algorithm on the web page here:
   -- https://www.euclideanspace.com/maths/topology/topologicalSpace/finite/all/index.htm
   allTopologiesOnSet(s : List NNI) : List % ==
     dim:NNI := #s
     if dim=0 then return [topologyFinite [[]]]
     if dim=1 then return [topologyFinite cons([[]],[s])]
     -- start with degree 0, an empty open set
     allTopologiesRecursive([[]],1,dim)

   -- Given a set, count all possible topologies on that set
   countAllTopologiesOnSet(s : List NNI) : NNI ==
     dim:NNI := #s
     if dim=0 then return 0
     if dim=1 then return 2
     -- start with degree 0, an empty open set
     #allTopologiesRecursive([[]],1,dim)

)abbrev domain TOPISO TopologyIsoClass
++ Author: Martin Baker
++ Description:
++   This represents a class of isomorphic topologies.
++   "=" is true if topologies are isomorphic.
++   for more documentation see:
++ References:
++   https://www.euclideanspace.com/prog/scratchpad/mycode/topology/finite/

TopologyIsoClass() : Exports == Impl where
  NNI==> NonNegativeInteger
  x<<y ==> hconcat(x::OutputForm, y::OutputForm)

  Exports ==> SetCategory() with

   -- constructor
   topologyIsoClass : (unlabeledOpenSets:List NNI, structure:List List NNI) -> %

   topologyIsoClassTrivial : () -> %
     ++ Constructor for trivial topology
     ++ Top and bottom are assumed so nothing to add

   topologyIsoClassDiscrete : (dim:NNI) -> %
     ++ Constructor for discrete topology
     ++ includes all open sets
     ++ Top and bottom are assumed so don't have to be explicitly listed

   topologyIsoClassLeftOrder : (dim:NNI) -> %
     ++ Constructor for order topology
     ++ The order topology may be considered on partially ordered sets as
     ++ well as linearly ordered sets
     ++ The open sets are {x | x<b} where b is 1..max
     ++ On a linearly ordered set it coincides with the interval topology


   listMeet : (a:%,os: NNI,os2:NNI) -> List NNI

   listJoin : (a:%,os: NNI,os2:NNI) -> List NNI

  Impl ==> add

   -- A representation of a topology isomorphism class consisting of:
   -- unlabeledOpenSets: the cardinality of each set
   -- substructure: subset lattice structure represented as a poset
   -- Only immediate subsets are listed (like Hasse diagram).
   -- Top and bottom are assumed so don't have to be explicitly listed.
   Rep := Record(unlabeledOpenSets:List NNI, substructure:List Record(superset:NNI,subset:NNI))

   -- constructor
   topologyIsoClass(unlabeledOpenSets:List NNI, structure:List List NNI) : % ==
     [unlabeledOpenSets, [[first x,second x] for x in structure]]

   topologyIsoClassTrivial() : % ==
     [[],[]]

   topologyIsoClassDiscrete(dim:NNI) : % ==
     pascal : List NNI := [(binomial(dim,i))::NNI for i in 1..(dim-1)]
     pascal2 : List List NNI := []
     for n in pascal for i in 1.. repeat
       pascal2 := cons([i for x in 1..n],pascal2)
     cardinalities : List NNI := reduce(concat,reverse pascal2)
     levels : List List List Integer := []
     for k in 1..dim repeat
       level: List List Integer :=[reverse subSet(dim,k,i)$SymmetricGroupCombinatoricFunctions for
           i in 0..binomial(dim,k)-1]
       levels := cons(level,levels)
     -- TODO calculate substructure
     substructure:List Record(superset:NNI,subset:NNI) := []
     print(message "topologyIsoClassDiscrete pascal2=" << pascal2 << message " levels=" << levels)
     [cardinalities,substructure]

   -- generate order topology
   topologyIsoClassLeftOrder(dim:NNI) : % ==
     cardinalities : List NNI := [x for x in 1..dim]
     substructure:List Record(superset:NNI,subset:NNI) := [[x+1,x] for x in 1..(dim-1)]
     [cardinalities,substructure]

   _=(a:%,b:%) : Boolean ==
     a.substructure=b.substructure

   -- display
   coerce(x : %) : OutputForm ==
     uos : List NNI := x.unlabeledOpenSets
     subs := x.substructure
     msg:OutputForm := message "topology class=" << uos << message " sub="
     msg << bracket[((a.superset)::OutputForm << message ">" << a.subset) for a in subs]

   addifnew(lst: List NNI,x:NNI) : List NNI ==
       if member?(x, lst) then return lst
       cons(x,lst)

   -- return supersets
   up(a:%,os: NNI) : List NNI ==
     res: List NNI := []
     for x in a.substructure repeat
       if os=x.subset then
         res:=addifnew(res,x.superset)
     res

   -- Return subsets of a given open set.
   -- Only return immediate subsets (not subsets of subsets)
   -- It is possible to have more than one subset so can return multiple values.
   -- os is index into unlabeledOpenSets
   down(a:%,os: NNI) : List NNI ==
     res: List NNI := []
     for x in a.substructure repeat
       if os=x.superset then
         res:=addifnew(res,x.subset)
         --print(message "down found x=" << x << message " os=" << os <<
         --    message " res=" << res)
     --print(message "down a=" << a << message " os=" << os <<
     --        message " res=" << res)
     res

   -- helper function for listMeet below
   listMeetHop(a:%,oss1:List NNI,oss2:List NNI,oss1Local:List NNI,oss2Local:List NNI) : List NNI ==
     print(message "listMeet a=" << a << message " oss1=" << oss1 <<
             message " oss2=" << oss2 << message " oss1Local=" << oss1Local <<
             message " oss2Local=" << oss2Local )
     res: List NNI := []
     for e in oss1Local repeat
       for e2 in oss2 repeat
         if e=e2 then res:=addifnew(res,e)
     for e in oss1 repeat
       for e2 in oss2Local repeat
         if e=e2 then res:=addifnew(res,e)
     if not (empty? res) then return sort res
     thisHop1: List NNI := []
     thisHop2: List NNI := []
     for os1 in oss1 repeat
       thisHop1 := concat(thisHop1,down(a,os1))
     for os2 in oss2 repeat
       thisHop2 := concat(thisHop2,down(a,os2))
     if (empty? thisHop1) and (empty? thisHop2) then return []
     listMeetHop(a,setUnion(oss1,thisHop1),setUnion(oss2,thisHop2),thisHop1,thisHop2)

   listMeet(a:%,os1: NNI,os2:NNI) : List NNI ==
     listMeetHop(a,[os1],[os2],[os1],[os2])

   -- helper function for listJoin below
   listJoinHop(a:%,oss1:List NNI,oss2:List NNI,oss1Local:List NNI,oss2Local:List NNI) : List NNI ==
     print(message "listJoin a=" << a << message " oss1=" << oss1 <<
             message " oss2=" << oss2 << message " oss1Local=" << oss1Local <<
             message " oss2Local=" << oss2Local )
     res: List NNI := []
     for e in oss1Local repeat
       for e2 in oss2 repeat
         if e=e2 then res:=addifnew(res,e)
     for e in oss1 repeat
       for e2 in oss2Local repeat
         if e=e2 then res:=addifnew(res,e)
     if not (empty? res) then return sort res
     thisHop1: List NNI := []
     thisHop2: List NNI := []
     for os1 in oss1 repeat
       thisHop1 := concat(thisHop1,up(a,os1))
     for os2 in oss2 repeat
       thisHop2 := concat(thisHop2,up(a,os2))
     if (empty? thisHop1) and (empty? thisHop2) then return []
     listJoinHop(a,setUnion(oss1,thisHop1),setUnion(oss2,thisHop2),thisHop1,thisHop2)

   listJoin(a:%,os1: NNI,os2:NNI) : List NNI ==
     listJoinHop(a,[os1],[os2],[os1],[os2])

)if false

   -- Return value indicates if the topology is valid upto the degree so far.
   -- degree 1 (singletons) contains combinations of open sets like [[1],[2]] etc.
   -- degree 2 contains combinations of open sets like [[1,2],[2,3]] etc.
   -- and so on.
   -- Even if this returns 'true' there may be higher degree open sets still required.
   -- (only checks downward)
   -- parameter 'allDegree' holds a possible topology which is valid upto the degree below
   -- returns true if these are compatible
   testValidTopol(a:%) : Boolean ==
     -- For a valid topology all joins and meets must exist
     uos:List NNI := a.unlabeledOpenSets
     subs:List Record(super:NNI,sub:NNI)) := a.substructure
     for x in allDegree for i in 1.. repeat
       for y in allDegree for i2 in 1.. repeat
         if i2>i then
           osJoin:List NNI := listJoin(x,y)
           if #osJoin <= degree then -- can only check upto this degree
             if not entry?(osJoin,allDegree) then
               return false
           osMeet:List NNI := listMeet(x,y)
           if not osMeet=[] then
             if not entry?(osMeet,allDegree) then
               return false
     true

   -- Given all potential topologies containing upto 'degree-1' open sets add
   -- 'degree' open sets then call recursivly until we get to 'maxDegree'.
   -- parameter 's' is all potential topologies containing only upto 'degree-1' open sets.
   -- degree 1 (singletons) contains combinations of open sets like [[1],[2]] etc.
   -- degree 2 contains combinations of open sets like [[1,2],[2,3]] etc. with degree 1
   -- and so on.
   allTopologiesRecursive(allDegree : List List NNI,
                          degree:NNI,maxDegree:NNI) : List % ==
     degree = maxDegree => [topologyFinite allDegree]
     -- only at top degree are we sure we have valid topology
     -- 'thisLevel' will hold all possible combinations of open sets for this degree
     thisLevel:List List List NNI := kFromNCombComb(degree,maxDegree)
     allValidTopol:List % := []
     for topolAtLevel in thisLevel repeat
       allDegreeSoFar : List List NNI :=
         if topolAtLevel=[[]]
           then allDegree
           else
             if allDegree=[[]]
               then topolAtLevel
               else concat(topolAtLevel,allDegree);
       if testValidTopol(allDegreeSoFar,degree) then
         validTopol : List % :=
           allTopologiesRecursive(allDegreeSoFar,
                          degree+1,maxDegree)
         allValidTopol := concat(validTopol,allValidTopol)
     allValidTopol

   -- Given a set, construct a list of all possible topologies on that set
   -- Warning: This function can return very long lists, if the input set is 6 or
   -- more elements then the computer may run out of resources and crash.
   -- I have written an explanation of this algorithm on the web page here:
   -- https://www.euclideanspace.com/maths/topology/topologicalSpace/finite/all/index.htm
   allTopologiesOnSet(s : List NNI) : List % ==
     dim:NNI := #s
     if dim=0 then return [topologyFinite [[]]]
     if dim=1 then return [topologyFinite cons([[]],[s])]
     -- start with degree 0, an empty open set
     allTopologiesRecursive([[]],1,dim)

)endif

)abbrev domain TOPOSP TopoSpaceFinite
++ Author: Martin Baker
++ Description:
++   TopoSpaceFinite topological space as set + opensets.
++   for more documentation see:
++ References:
++   https://www.euclideanspace.com/prog/scratchpad/mycode/topology/finite/

TopoSpaceFinite(S : SetCategory) : Exports == Impl where
  NNI==> NonNegativeInteger
  x<<y ==> hconcat(x::OutputForm, y::OutputForm)

  Exports ==> SetCategory() with

    topologyFinite : (List Symbol) -> %
      ++ constructor

    topoSpaceFiniteTrivial : (List String) -> %
      ++ Constructor for trivial topology
      ++ Only empty and full open sets (don't need to be explicitly included)

    topoSpaceFiniteDiscrete : (List String) -> %
      ++ Constructor for discrete topology
      ++ includes all open sets
      ++ Don't need to explicitly include empty and full set

    topoSpaceFiniteLeftOrder : (List String) -> %
      ++ Constructor for order topology
      ++ The order topology may be considered on partially ordered sets as
      ++ well as linearly ordered sets
      ++ The open sets are {x | x<b} where b is 1..max
      ++ On a linearly ordered set it coincides with the interval topology

    coerce : (x : %) -> OutputForm
      ++ display as symbols

    getTopology : (x : %) -> TopologyFinite

    getTopologyToList : (x : %) -> List List NNI

    product : (a : %, b : %) -> %
      ++ The product topology is the coarsest topology (the topology
      ++ with the fewest open sets) which still has continuous projections
      ++ to the input topologies.

    nerveConstruction : (a : %) -> FiniteSimplicialComplex(Integer)
      ++ A nerve construction creates a simplicial complex with the
      ++ topological properties of a given set family.
      ++ The nerve construction is based on a cover of the set family
      ++ The resulting complex is a discrete representation of that cover.

  Impl ==> add

   -- A set and a topology on it.
   Rep := Record(topSet : List S, topol : TopologyFinite)

   getTopology(x : %) : TopologyFinite ==
     x.topol

   getTopologyToList(x : %) : List List NNI ==
     getTopology(x.topol)

   -- constructor
   topoSpaceFinite(a : List S) : % ==
     [a,topologyFiniteTrivial()]

   if S is Symbol then topoSpaceFiniteTrivial(x1 : List String) : % ==
     [[a::Symbol for a in x1],topologyFiniteTrivial()]

   -- local function to add if new
   addIfNew(lst : List(List(NNI)), unsorted : List(NNI)) : List(List(NNI)) ==
       if empty?(unsorted) then return lst
       sorted : List(NNI) := sort(unsorted)
       if member?(sorted, lst) then return lst
       cons(sorted,lst)

   if S is Symbol then topoSpaceFiniteDiscrete(x1 : List String) : % ==
     dim1:NNI := #x1
     [[a::Symbol for a in x1],topologyFiniteDiscrete(dim1)]

   -- generate order topology
   if S is Symbol then topoSpaceFiniteLeftOrder(x1 : List String) : % ==
     dim1:NNI := #x1
     [[a::Symbol for a in x1],topologyFiniteLeftOrder(dim1)]

   -- display as symbols
   coerce(x : %) : OutputForm ==
     x1:List S := x.topSet
     topSet1:OutputForm := bracket[a::OutputForm for a in x1]
     bracket[topSet1,(x.topol)::OutputForm]

   _=(a:%,b:%) : Boolean ==
     a.topol = b.topol

   -- The product topology is the coarsest topology (the topology
   -- with the fewest open sets) which still has continuous projections
   -- to the input topologies.
   product(a : %, b : %) : % ==
     a1:List S := a.topSet
     b1:List S := b.topSet
     -- convert inputs to basis
     a2:TopologyFinite := full2basis(a.topol)
     b2:TopologyFinite := full2basis(b.topol)
     -- Cartesian product of sets
     pairs:List(Record(left : S, right : S)) := empty
     for sa in a1 repeat
       for sb in b1 repeat
         pair:Record(left : S, right : S) := [sa,sb]
         pairs := cons(pair,pairs)
     print(message "points=" << pairs)
     topols:List(Record(tl : List(NNI), tr : List(NNI))) := empty
     for ta in getTopology(a2) repeat
       for tb in getTopology(b2) repeat
         topol:Record(tl : List(NNI), tr : List(NNI)) := [ta,tb]
         topols := cons(topol,topols)
     print(message "topols=" << topols)
     [a1,a2]

   -- https://sauln.github.io/blog/towers-nerves/
   -- A nerve construction creates a simplicial complex with the
   -- topological properties of a given set family.
   -- The nerve construction is based on a cover of the set family
   -- The resulting complex is a discrete representation of that cover.
   nerveConstruction(a : %) : FiniteSimplicialComplex(Integer) ==
     -- For each nonempty intersection of n elements in the cover,
     -- add an (n-1)-dimensional simplex.
     a1:TopologyFinite := a.topol
     nerveConstruction(a1)

)abbrev domain CONTMAP ContinuousMap
++ Author: Martin Baker
++ Description:
++   A continuous map between two topological spaces
++   for more documentation see:
++ References:
++   https://www.euclideanspace.com/prog/scratchpad/mycode/topology/finite/

ContinuousMap(DOMAIN:TopoSpaceFinite(Symbol),CODOMAIN:TopoSpaceFinite(Symbol)) : Exports == Impl where
  NNI==> NonNegativeInteger
  x<<y ==> hconcat(x::OutputForm, y::OutputForm)

  Exports ==> SetCategory() with

    -- for now just use NNI indexes, later may generalise like this:
    -- continuousMap : (im:Table(NNI,NNI),preIm:Table(NNI,NNI)) -> %
    continuousMap : (im:List NNI) -> %
      ++ Construct from only image and reconstuct pre-image
    continuousMap : (im:List NNI,preIm:List NNI) -> %
      ++ Construct given image and pre-image

    getContents : (x : %) -> Record(image:List NNI,preImage:List NNI)

  Impl ==> add

   -- image: a map of the points in the forward direction.
   -- preImage: a map of the open sets in the reverse direction.
   -- for now just use NNI indexes, later may generalise like this:
   -- Rep := Record(image:Table(NNI,NNI),preImage:Table(NNI,NNI))
   Rep := Record(image:List NNI,preImage:List NNI)

   -- constructor
   continuousMap(im:List NNI) : % ==
     t1 :List List NNI := getTopologyToList(DOMAIN)
     t2 :List List NNI := getTopologyToList(CODOMAIN)
     -- print (message "top in=" << t1 << message " top out=" << t2 << message " im=" << im)
     preImMap:List NNI := []
     -- for every open set in the codomain
     for os in t2 repeat
       currentPreIm:List NNI := []
       -- for every point p in the codomain i is its preimage
       for p in im for i in 1..(#im) repeat
         if member?(p,os) then
           if not member?(i,currentPreIm) then
             currentPreIm := cons(i,currentPreIm)
       -- print (message "  os=" << os << message " preIm=" << currentPreIm)
       sortedPreIm:List NNI := sort currentPreIm
       if entry?(sortedPreIm,t1)
         then
           -- print (message " open set:=" << sortedPreIm << message " is in domain")
           preImMap := cons(qcoerce(position(sortedPreIm,t1)),preImMap)
         else
           print (message " open set:=" << sortedPreIm << message " not in domain")
           error "invalid continuous map"
     [im,preImMap]

   -- constructor
   continuousMap(im:List NNI,preIm:List NNI) : % ==
     if empty?(preIm) then return continuousMap(im)
     [im,preIm]

   getContents(x : %) : Record(image:List NNI,preImage:List NNI) ==
     x::Rep

   coerce(x : %) : OutputForm ==
     x1:List NNI := (x.image)
     x2:List NNI := (x.preImage)
     message "map image=" << bracket [a::OutputForm for a in x1] <<
       message " preimage=" << bracket [a::OutputForm for a in x2]

)abbrev domain HOMSET Homset
++ Author: Martin Baker
++ Description:
++   A set of continuous maps between two topological spaces
++   may be a homotopy
++   for more documentation see:
++ References:
++   https://www.euclideanspace.com/prog/scratchpad/mycode/topology/finite/

Homset(DOMAIN:TopoSpaceFinite(Symbol),CODOMAIN:TopoSpaceFinite(Symbol)) : Exports == Impl where
  NNI==> NonNegativeInteger
  x<<y ==> hconcat(x::OutputForm, y::OutputForm)

  Exports ==> SetCategory() with

    allMaps:(maxDomain:NNI,maxCodomain:NNI) -> List List NNI

    homset : () -> %
      ++ Multiple possible maps from only images and reconstuct pre-images

  Impl ==> add

   -- image: a map of the points in the forward direction.
   -- preImage: a map of the open sets in the reverse direction.
   Rep := List Record(image:List NNI,preImage:List NNI)

   incrementImage(im:List NNI,pos:NNI,maxDomain:NNI,maxCodomain:NNI) : List NNI ==
     if empty?(im) then return im
     val:NNI := elt(im,pos)
     imCopy:List NNI := copy im
     if val < maxDomain then
       setelt!(imCopy,pos,val+1)
       return imCopy
     setelt!(imCopy,pos,1)
     if pos+1 > maxCodomain then return []
     incrementImage(imCopy,pos+1,maxDomain,maxCodomain)

   -- local function to generate all possible maps
   allMaps(maxDomain:NNI,maxCodomain:NNI) : List List NNI ==
     currentDomain:NNI := 1
     currentCodomain:NNI := 1
     im:List NNI := [1 for ignore in 1..maxDomain]
     res: List List NNI := [copy im]
     -- print (message "allMaps1 im:" << im << message " currentDomain:" << currentDomain <<
     --   message " currentCodomain:" <<  currentCodomain)
     while true repeat
       im := incrementImage(im,1,maxCodomain,maxDomain)
       if empty?(im) then return res
       res:= cons(im,res)
     res

   preImageFromImage(im:List NNI) : List NNI ==
     t1 :List List NNI := getTopologyToList(DOMAIN)
     t2 :List List NNI := getTopologyToList(CODOMAIN)
     -- print (message "preImage: top in=" << t1 << message " top out=" << t2 << message " im=" << im)
     preImMap:List NNI := []
     -- for every open set in the codomain
     for os in t2 repeat
       currentPreIm:List NNI := []
       -- for every point p in the codomain i is its preimage
       for p in im for i in 1..(#im) repeat
         if member?(p,os) then
           if not member?(i,currentPreIm) then
             currentPreIm := cons(i,currentPreIm)
       -- print (message "  preImage: os=" << os << message " preIm=" << currentPreIm)
       sortedPreIm:List NNI := sort currentPreIm
       if entry?(sortedPreIm,t1)
         then
           -- print (message " preImage: open set:=" << sortedPreIm << message " is in domain")
           preImMap := cons(qcoerce(position(sortedPreIm,t1)),preImMap)
         else
           -- print (message " preImage: open set:=" << sortedPreIm << message " not in domain")
           return []
     preImMap

   -- constructor
   homset() : % ==
     maxDomain:NNI := #getTopologyToList(DOMAIN) -- number of points in domain
     maxCodomain:NNI := #getTopologyToList(CODOMAIN) -- number of points in codomain
     -- print (message "homset: domain=" << getTopologyToList(DOMAIN) << message " size=" << #getTopologyToList(DOMAIN))
     -- print (message "homset: codomain=" << getTopologyToList(CODOMAIN) << message " size=" << #getTopologyToList(CODOMAIN))
     all : List List NNI := allMaps(maxDomain,maxCodomain)
     -- print (message "homset: all=" << all)
     res : List Record(image:List NNI,preImage:List NNI) := []
     for im in all repeat
       pm : List NNI := preImageFromImage(im)
       -- print (message " next image:" << im << message " preimage:" << pm)
       if not empty?(pm) then
         -- print (message "not empty")
         currentRep : Record(image:List NNI,preImage:List NNI) := [im,pm]
         res := cons(currentRep,res)
     res

   outputOneEntry(x : Record(image:List NNI,preImage:List NNI)) : OutputForm ==
     x1:List NNI := (x.image)
     x2:List NNI := (x.preImage)
     message "map image=" << bracket [a::OutputForm for a in x1] <<
       message " preimage=" << bracket [a::OutputForm for a in x2]

   coerce(x : %) : OutputForm ==
     message "homset" << bracket[outputOneEntry(a) for a in x]


)abbrev domain SUBLAT SubLattice
++ Author: Martin Baker
++ Description:
++   This is a complete lattice specified by basis nodes. That is the elements of the
++   lattice may be specified either directly by a number such as '1' (basis node) or
++   other nodes are only implied by a join of multiple numbers such as '1\/2\/3'.
++   This is a complete lattice in that, if the lattice is divided into open sets, then
++   these open sets have all meets and joins and top and bottom.
++   These meets and joins can be extended to the whole topology, so it is a sub-topology.
++   We can also define meets and joins of the sub-lattices themselves, these are only
++   closed for meets so, for whole sub-lattices, it is a MeetSemilattice.
++   Joins of whole sub-lattices are not closed but can 'split' into two lattices
++   (see weakJoin) this is like 'glueing' lattices together.
++   for more documentation see:
++ References:
++   https://www.euclideanspace.com/prog/scratchpad/mycode/topology/finite/

SubLattice() : Exports == Impl where
  NNI==> NonNegativeInteger
  x<<y ==> hconcat(x::OutputForm, y::OutputForm)

  Exports ==> MeetSemilattice with

    subLattice : (bottom:List NNI,basis:List List NNI) -> %
      ++ constructor: parameters are -
      ++ bottom: is extension set. This is an open set which is included in every
      ++        node so we factor it out to here.
      ++ basis: is complete lattice on given set
      ++ these are checked for disjointedness

    getBasis : (a:%) -> List List NNI
      ++ Returns the basis of this sub-lattice

    getBottom : (a:%) -> List NNI
      ++ Returns the bottom element of this sub-lattice

    membersBasis : (s1:%) -> List List NNI
      ++ Nodes of whole lattice in this sub-lattice basis
      ++ when bottom is added to them all.

    membersAll : (s1:%) -> List List NNI
      ++ Nodes of whole lattice in this sub-lattice
      ++ when bottom is added to them all.

    memberElement? : (x:List NNI, s1:%) -> Boolean
      ++ is an element a member of this sub-lattice

    empty1? : (s1 : %) -> Boolean
      ++ true if both lattice and extension are empty

    cardinality1 : (s1:%) -> NNI
      ++ number of elements in both lattice and extension

    openSets : (a:%) -> List List NNI
      ++ Expand out basis elements into all combinations of basis elements (powerset)
      ++ with bottom included in each.
      ++ The result can be interpreted as the open sets that make up this lattice

    openSetsNoOffset : (a:%) -> List List NNI
      ++ Expand out basis elements into all combinations of basis elements (powerset)
      ++ with no offset for bottom.

    weakJoin : (bb:%,aa:%) -> List %
      ++ weak join of 'a' and 'b'
      ++ uses weak distributive rule: (A+B) \/ C = split: (A \/ C + B) , (B \/ C + A)

    joinVector : (a:%,vec:List %) -> List %
      ++ join 'a' to each element of vector

    subtractElements : (a : List NNI,bb : %) -> List NNI
      ++ Remove all elements in sub-lattice 'bb' from set 'a'.

    merge : (existingLattice : %,newBasis:%) -> %

    subset? : (a : %,b:%) -> Boolean

    addLattice : (aa:%,bb:%) -> %
      ++ add two lattices by merging their basis open sets

    addVector : (a:%,vec:List %) -> List %
      ++ add (split A+B:=[A,B]) 'a' to each element of vector

    nextVector : (a:%,vec:List %,trace : Boolean) -> List %
      ++ For each element in the vector do both of:
      ++ - Join (union) with 'a'
      ++ - Add (split A+B:=[A,B]) to 'a'

    subFace : (aa:%,element:List NNI) -> %
      ++ re-factor to give a SubLattice whose bottom is the given element.

    top : (a:%) -> List NNI
      ++ Element of whole lattice which is top element of this sub lattice.

    join : (a:%, b:%) -> List %
      ++ The union of two complete lattices is not closed
      ++ so produce a list instead

  Impl ==> add

   -- Rep holds bottom and basis where:
   -- basis represents complete lattice on given set
   --   the inner list is join of elements to give a node of lattice
   --   outer list is basis
   --   taking the power set of the outer list gives all elements of lattice.
   -- bottom holds basis common to all nodes. Can think of this as an offset.
   Rep := Record(bottom:List NNI,basis:List List NNI)

   -- local function - helper for formatting output
   stringSeperatedList(ts:List OutputForm,sep : String) : OutputForm ==
     res:List OutputForm := []
     for t in ts for i in 1.. repeat
       if i=1
         then res := cons(t,res)
         else
           res := cons(message sep,res)
           res := cons(t,res)
     hconcat (reverse res)

   -- returns true if 'a' is a subset of 'b'.
   --isSubset?(a:List NNI,b:List NNI) : Boolean ==
   --  for a1 in a repeat
   --    if not member?(a1,b) then return false
   --  true

   -- local function used by constructor to check validity
   -- For valid lattice all basis must be independant.
   -- (can only contain each element once)
   isIndependant?(basis:List List NNI) : Boolean ==
     for x in basis for i in 1.. repeat
       for y in basis for j in 1.. repeat
         if i<j then
           if setIntersection(x,y) ~= [] then return false
     true

   -- local function used by constructor to sort into canonical form
   gradeAndOrder(a:List NNI,b:List NNI) : Boolean ==
     if #a < #b then return true
     if #a > #b then return false
     sa:List NNI := sort a
     sb:List NNI := sort b
     for ia in sa for ib in sb repeat
         if ia < ib then return true
         if ia > ib then return false
     false

   -- constructor: parameters are:
   -- bottom is extension set
   -- basis is complete lattice on given set
   -- these are checked for disjointedness
   subLattice(bottom:List NNI,basis:List List NNI) : % ==
     if member?(bottom,basis) then
         print (message "Attempt to construct subLattice basis=" << _
         stringSeperatedList([x::OutputForm for x in bottom]$List(OutputForm),"\/") <<
         message " bottom=" <<
         stringSeperatedList([x::OutputForm for x in basis]$List(OutputForm),"+"))
         error "basis and bottom must be disjoint"
     if not isIndependant?(basis) then
         print (message "Attempt to construct subLattice bottom=" << _
         stringSeperatedList([x::OutputForm for x in bottom]$List(OutputForm),"\/") <<
         message " basis=" <<
         stringSeperatedList([x::OutputForm for x in basis]$List(OutputForm),"+"))
         error "all basis must be independant"
     -- sort into canonical form:
     [sort bottom,sort(gradeAndOrder,basis)]

   getBasis(a:%) : List List NNI ==
     a.basis

   getBottom(a:%) : List NNI ==
     a.bottom

   -- Nodes of whole lattice in this basis for sub-lattice
   -- when bottom is added to them all.
   membersBasis(s1:%) : List List NNI ==
     s:List List NNI := s1.basis
     s2:List NNI := s1.bottom
     [sort setUnion(s2,s3) for s3 in s]

   -- Nodes of whole lattice in this basis for sub-lattice
   -- when bottom is added to them all.
   membersAll(s1:%) : List List NNI ==
     s:List List NNI := openSets s1
     -- [sort concat s3 for s3 in s]

   -- is an element a member of this sub-lattice
   memberElement?(x:List NNI, s1:%) : Boolean ==
     for y in membersBasis(s1) repeat
       if x=y then return true
     false

   -- 'a' holds remaining basis elements so remove all elements in
   -- sub-lattice 'bb' from set 'a'.
   subtractElements(a : List NNI,bb : %) : List NNI ==
     --print(message "subtractElements a=:" << a << message "-" << bb)
     bbottom:List NNI := bb.bottom
     b:List List NNI := bb.basis
     x :List NNI := reduce(setUnion,b,[])
     x:= setUnion(x,bbottom)
     res : List NNI := a
     --print(message "subtractElements x=" << x << message " res=" << res)
     for b1 in x repeat
       res := remove(b1,res)
       --print(message "subtractElements b1=" << b1 << message " res=" << res)
     --print(message "subtractElements res=" << res)
     sort res

   merge(existingLattice : %,newBasis:%) : % ==
     b:List NNI := concat(existingLattice.bottom,newBasis.bottom)
     m:List List NNI := concat(existingLattice.basis,newBasis.basis)
     if not isIndependant?(m) then
       print (message "merge non independant error m=" << m << message " newBasis=" << newBasis)
     subLattice(b,m)

   subset?(a : %,b:%) : Boolean ==
     if empty1? b then return false
     abasis: List List NNI := getBasis(a)
     abottom : List NNI := getBottom(a)
     bbasis: List List NNI := getBasis(b)
     bbottom : List NNI := getBottom(b)
     aBasisElements : List NNI := setUnion(reduce(setUnion,abasis,[]),abottom)
     bBasisElements : List NNI := setUnion(reduce(setUnion,bbasis,[]),bbottom)
     for x in aBasisElements repeat
       if not member?(x,bBasisElements) then return false
     true

   -- local recursive helper function for openSets
   -- to generate complete lattice (power set)
   powerSet(s:List List NNI) : List List List NNI ==
     empty? s => [s]
     concat(p:=powerSet(rest s),[cons(first s,x) for x in p])

   -- Expand out basis elements into all combinations of basis elements (powerset)
   -- with bottom included in each.
   -- The result can be interpreted as the open sets that make up this lattice
   openSets(a:%) : List List NNI ==
     lat:List List NNI := a.basis
     e:List NNI := a.bottom
     expanded:List List List NNI := powerSet lat
     nodes : List List NNI := [reduce(setUnion,x,[]) for x in expanded]
     sort [sort concat(e,x) for x in nodes]

   -- Expand out basis elements into all combinations of basis elements (powerset)
   -- with no offset for bottom.
   openSetsNoOffset(a:%) : List List NNI ==
     lat:List List NNI := a.basis
     expanded:List List List NNI := powerSet lat
     [reduce(setUnion,x,[]) for x in expanded]

   -- weak join of 'a' and 'b'
   -- uses weak distributive rule: (A+B) \/ C = split: (A \/ C + B) , (B \/ C + A)
   weakJoin(bb:%,aa:%) : List % ==
     abottom:List NNI := aa.bottom
     a:List List NNI := aa.basis
     bbottom:List NNI := bb.bottom
     b:List List NNI := bb.basis
     if a=[] or a=[[]] then return [bb]
     if b=[] or b=[[]] then return [aa]
     if abottom ~= bbottom then
         print(message "error in weakJoin: base of " << aa <<
               message "~= base of " << bb)
     res: List % := []
     for a1 in a repeat
       for b1 in b repeat
         a2:List List NNI := remove(a1,a)
         b2:List List NNI := remove(b1,b)
         d:List List NNI := [setUnion(a1,b1)]
         d := setUnion(b2,setUnion(a2,d))
         if not isIndependant?(d) then -- setUnion calculated twice *************
           print(message "error in weakJoin: not independant:" << aa <<
               message "+" << bb)
         res := cons(subLattice(abottom,d),res) -- use constructor to enforce canonical form
     reverse res

   -- join 'a' to each element of vector
   joinVector(a:%,vec:List %) : List % ==
     if empty1? a then return vec
     res : List % := []
     for v in vec repeat
       res := setUnion(weakJoin(a,v),res)
     res

   -- add two lattices by merging their basis
   addLattice(aa:%,bb:%) : % ==
     abottom:List NNI := aa.bottom
     a:List List NNI := aa.basis
     bbottom:List NNI := bb.bottom
     b:List List NNI := bb.basis
     if abottom ~= bbottom then
         print(message "error in addLattice: base of " << aa <<
               message "~= base of " << bb)
     if b=[] or b=[[]] then return aa
     if not isIndependant?(setUnion(a,b)) then -- setUnion calculated twice *************
       print(message "error in addLattice: not independant:" << aa <<
             message "+" << bb)
     subLattice(abottom,setUnion(a,b)) -- use constructor to enforce canonical form

   -- add (split A+B:=[A,B]) 'a' to each element of vector
   addVector(a:%,vec:List %) : List % ==
     if empty1? a then return vec
     [addLattice(a,v) for v in vec | not empty1? v]

   -- For each element in the vector do both of:
   -- - Join (union) with 'a'
   -- - Add (split A+B:=[A,B]) to 'a'
   nextVector(element:%,vec:List %,trace : Boolean) : List % ==
     res : List % := vec
     if trace then
        print(message "        nextVector element=" << element << message " vec=" << vec)
     addv : List % := addVector(element,vec)
     joinv : List % := joinVector(element,vec)
     if trace then
       print(message "nextVector element=" << element << message " vec=" << vec <<
             message " addv=" << addv)
       print(message "           joinv=" << joinv)
     res := setUnion(addv,res)
     setUnion(joinv,res)

   -- re-factor to give a SubLattice whose bottom is the given element.
   subFace(aa:%,element:List NNI) : % ==
     abottom:List NNI := aa.bottom
     a:List List NNI := aa.basis
     if element=[] then
       print(message "Error in subFace: element=[] " << aa)
       return aa
     if a=[] or a=[[]] then
       print(message "Error in subFace: a=[] " << element)
       return aa
     exp : List List NNI := openSetsNoOffset(aa)
     if not member?(element,exp) then
       print(message "Error in subFace: invalid element " << element << message " in " << aa)
       return aa
     if setIntersection(abottom,element) ~= [] then
       print(message "Error in subFace: element is bottom " << element << message " in " << aa)
       return aa
     newBottom:List NNI := setUnion(abottom,element)
     newBasis:List List NNI := []
     for b in a repeat
       if setIntersection(b,element) = [] then newBasis := cons(b,newBasis)
     subLattice(newBottom,reverse newBasis)

   top(a:%) : List NNI ==
     m : List List NNI := membersBasis(a)
     if m=[] or m=[[]] then return []
     r : List NNI := reduce(setUnion,m)
     sort r

   -- meet of two sub-lattices
   _/_\(a:%, b:%) : % ==
     abottom:List NNI := a.bottom
     alat:List List NNI := a.basis
     bbottom:List NNI := b.bottom
     blat:List List NNI := b.basis
     if (empty1? a) or (empty1? b) then return [[],[]]
     if abottom=bbottom then
         if alat=blat then return a
         return [setUnion(abottom,bbottom),[]]
     m1:List List NNI := setIntersection(alat,alat) -- interset with itself????????????????
     m2:List List NNI := setIntersection(blat,blat)
     [setUnion(abottom,bbottom),[]]

   -- The union of two complete lattices is not closed
   -- so produce a list instead
   join(a:%, b:%) : List % ==
     if a=b then return [a]
     if (empty1? a) and (empty1? b) then return []
     if empty1? a then return [b]
     if empty1? b then return [a]
     [a,b]

   customSeperatedList(ts:List OutputForm,seperator:String) : OutputForm ==
     res:List OutputForm := []
     #ts=1 => first ts
     for t in ts for i in 1.. repeat
       if i=1
         then res := cons(t,res)
         else
           res := cons(message seperator,res)
           res := cons(t,res)
     hconcat (reverse res)

   formatInner(osin:List NNI) : OutputForm ==
     #osin=0 => message "0"
     #osin=1 => (first osin)::OutputForm
     customSeperatedList([x::OutputForm for x in osin],"\/")

   formatOS(os:List List NNI) : OutputForm ==
     os2:List OutputForm := [formatInner(x) for x in os]
     customSeperatedList(os2,"+")

   coerce(s : %) : OutputForm ==
     st : List NNI := s.bottom
     stOut:OutputForm := formatInner(st)
     fi : List List NNI := parts (s.basis)
     if empty?(st) and empty?(s.basis) then return (message "0")
     if empty?(st) then return (message "P") << (brace (formatOS fi))
     if empty?(s.basis) then return stOut
     stOut << (message "*P") << (brace (formatOS fi))

   -- Constructors ensure these subLattices are sorted into canonical form so
   -- they are equal if basis and bottom are equal.
   _=(a:%,b:%) : Boolean ==
     (a.basis = b.basis) and (a.bottom = b.bottom)

   empty1?(s1 : %) : Boolean ==
     empty?(s1.bottom) and empty?(s1.basis)

   cardinality1(s1:%) : NNI ==
     s:List NNI := s1.bottom
     s2:List List NNI := s1.basis
     -- cardinality(s)+cardinality(s2)
     0

)abbrev domain TOPEXT TopolExtension
++ Author: Martin Baker
++ Description:
++   This specifies an extension to a sub-topology.
++   for more documentation see:
++ References:
++   https://www.euclideanspace.com/prog/scratchpad/mycode/topology/finite/

TopolExtension() : Exports == Impl where
  NNI==> NonNegativeInteger
  x<<y ==> hconcat(x::OutputForm, y::OutputForm)

  Exports ==> SetCategory() with

    topolExtension : (ext:List Record(sublat:SubLattice,
              extension:List Record(source:List NNI,target:List List NNI))) -> %
      ++ constructor: parameters are -
      ++ sublat : sub-lattices being extended
      ++ extension : source and target points

    example : () -> %

    extend : (ext : %) -> List SubLattice

    allExtensions : (start : List SubLattice, top:List NNI) -> List %

    allLatticesNoRepeatedElements : (basis:List NNI,trace : Boolean) -> List List List NNI
      ++ All lattices where each 'element' is included 0 or 1 times but not more.
      ++ An 'element' may be a basis element (such as 1) or a join of basis (such as 1\/2).
      ++ if basis=[1,2] then output is: [],[1],[2],[1\/2],[1+2]
      ++ if basis=[1,2,3] then output is: [],[1],[2],[3],[1\/2],[1\/3],[2\/3],[2+1],
      ++                   [3+1],[3+2],[1+2\/3],[2+1\/3],[3+1\/2],[1\/2\/3],[3+2+1]
      ++ Local function used by allExtensions function.

  Impl ==> add

   Rep := List Record(sublat:SubLattice,
          extension:List Record(source:List NNI,target:List List NNI))

   -- local function - helper for formatting output
   topolExtension(ext:List Record(sublat:SubLattice,
            extension:List Record(source:List NNI,target:List List NNI))) : % ==
     ext

   example() : % ==
     b := subLattice([],[[1,2]]) -- P{1\/2}
     e1 : Record(source:List NNI,target:List List NNI) := [[1],[[3]]]
     e2 : Record(source:List NNI,target:List List NNI) := [[2],[[4]]]
     x : Record(sublat:SubLattice,
          extension:List Record(source:List NNI,target:List List NNI)) := [b,[e1,e2]]
     [x]

   coerce(ext : %) : OutputForm ==
     res:List OutputForm := []
     for e in ext repeat
       extens:List Record(source:List NNI,target:List List NNI) := e.extension
       res1:List OutputForm := []
       for exten in extens repeat
         s:OutputForm := (exten.source)::OutputForm << message "->" << exten.target
         res1 := cons(s,res1)
       res := cons((e.sublat)::OutputForm << bracket res1,res)
     bracket res

   extend(ext : %) : List SubLattice ==
     trace : Boolean := false --true
     res:List SubLattice := []
     for e in ext repeat
       extens:List Record(source:List NNI,target:List List NNI) := e.extension
       basis : List List NNI := getBasis(e.sublat)
       bottom : List NNI := getBottom(e.sublat)
       if trace then
         print(message "extend extens=" << extens <<
               message " basis=" << basis <<
               message " bottom=" << bottom)
       res1:List SubLattice := []
       for exten in extens repeat
         sor : List NNI := exten.source
         tar : List List NNI := exten.target
         newBasis : List List NNI := [setDifference(b,sor) for b in basis]
         newBasis2 : List List NNI := setUnion(tar,newBasis)
         newBasis := [x for x in newBasis2 | x ~= []]
         newBottom : List NNI := setUnion(sor,bottom)
         if trace then
           print(message "extend   sor=" << sor <<
                 message " tar=" << tar <<
                 message " newBottom=" << newBottom <<
                 message " newBasis=" << newBasis)
         sl:SubLattice := subLattice(newBottom,newBasis)
         res1 := cons(sl,res1)
       res := setUnion(res,res1)
     res

   -- For valid lattice all basis must be independant.
   -- They can only contain the same element once.
   isIndependant?(basis:List List NNI) : Boolean ==
     for x in basis for i in 1.. repeat
       for y in basis for j in 1.. repeat
         if i<j then
           if setIntersection(x,y) ~= [] then return false
     true

   -- weak join of 'a' and 'b'
   -- uses weak distributive rule: (A+B) \/ C = split: (A \/ C + B) , (B \/ C + A)
   weakJoin(b:List List NNI,a:List List NNI) : List List List NNI ==
     if a=[] or a=[[]] then return [b]
     if b=[] or b=[[]] then return [a]
     res: List List List NNI := []
     for a1 in a repeat
       for b1 in b repeat
         a2:List List NNI := remove(a1,a)
         b2:List List NNI := remove(b1,b)
         d:List List NNI := [setUnion(a1,b1)]
         d := setUnion(b2,setUnion(a2,d))
         if not isIndependant?(d) then -- setUnion calculated twice *************
           print(message "error in weakJoin: not independant:" << a <<
               message "+" << b)
         res := cons(d,res) -- use constructor to enforce canonical form
     reverse res

   -- join 'a' to each element of vector
   joinVector(a:List List NNI,vec:List List List NNI) : List List List NNI ==
     if empty? a then return vec
     res : List List List NNI := []
     for v in vec repeat
       res := setUnion(weakJoin(a,v),res)
     res

   -- add two lattices by merging their basis
   addLattice(a:List List NNI,b:List List NNI) : List List NNI ==
     if b=[] or b=[[]] then return a
     if not isIndependant?(setUnion(a,b)) then -- setUnion calculated twice *************
       print(message "error in addLattice: not independant:" << a <<
             message "+" << b)
     setUnion(a,b) -- use constructor to enforce canonical form

   -- add (split A+B:=[A,B]) 'a' to each element of vector
   addVector(a:List List NNI,vec:List List List NNI) : List List List NNI ==
     if empty? a then return vec
     [addLattice(a,v) for v in vec | not empty? v]

   -- For each element in the vector do both of:
   -- - Join (union) with 'a'
   -- - Add (split A+B:=[A,B]) to 'a'
   nextVector(element:List List NNI,vec:List List List NNI,trace : Boolean) : List List List NNI ==
     res : List List List NNI := vec
     if trace then
        print(message "        nextVector element=" << element << message " vec=" << vec)
     addv : List List List NNI := addVector(element,vec)
     joinv : List List List NNI := joinVector(element,vec)
     if trace then
       print(message "nextVector element=" << element << message " vec=" << vec <<
             message " addv=" << addv)
       print(message "           joinv=" << joinv)
     res := setUnion(addv,res)
     setUnion(joinv,res)

   -- All lattices where each 'element' is included 0 or 1 times but not more.
   -- An 'element' may be a basis element (such as 1) or a join of basis (such as 1\/2).
   -- if basis=[1,2] then output is: [],[1],[2],[1\/2],[1+2]
   -- if basis=[1,2,3] then output is: [],[1],[2],[3],[1\/2],[1\/3],[2\/3],[2+1],
   --                   [3+1],[3+2],[1+2\/3],[2+1\/3],[3+1\/2],[1\/2\/3],[3+2+1]
   -- Local function used by allExtensions function.
   allLatticesNoRepeatedElements(basis:List NNI,trace : Boolean) : List List List NNI ==
     if trace then
       print(message "      allLatticesNoRepeatedElements basis=" << basis)
     if #basis < 1 then
       return []
     res : List List List NNI := []
     for ele in basis repeat
       newBasis : List List NNI := [[ele]]
       if empty? res
         then
           res := [[],newBasis]
           -- subLattice([],[]) not stricly correct as empty lattice is
           -- not a valid lattice but is required as a marker.
         else
           if not isIndependant?(newBasis) then
             print(message "allLatticesNoRepeatedElements2 basis not independant. newBasis=" << newBasis)
             return res
           if trace then
             print(message "         allLatticesNoRepeatedElements3 basis=" << basis)
             print(message "         newBasis=" << newBasis << message " res=" << res)
           res : List List List NNI := nextVector(newBasis,res,false)
     if trace then
       print(message "      allLatticesNoRepeatedElements4 basis=" << basis)
       print(message "         res=" << res)
     res


   -- local recursive helper function for openSets
   -- to generate complete lattice (power set)
   powerSet(s:List NNI) : List List NNI ==
     empty? s => [s]
     concat(p:=powerSet(rest s),[cons(first s,x) for x in p])

   allExtensions(start : List SubLattice, top:List NNI) : List % ==
     trace : Boolean := false
     res : List % := []
     if start=[] then
       remComb : List List List NNI := allLatticesNoRepeatedElements(top,false)
       for r in remComb repeat
         n:List NNI := []
         e:Record(source:List NNI,target:List List NNI) := [n,r]
         e1 : Record(sublat:SubLattice,
            extension:List Record(source:List NNI,target:List List NNI)) := [subLattice([],[]),[e]]
         res := cons(topolExtension [e1], res)
       return res
     for thisStart in start repeat
       remaining : List NNI := subtractElements(top,thisStart)
       remComb : List List List NNI := allLatticesNoRepeatedElements(remaining,false)
       nodes : List List NNI := openSetsNoOffset(thisStart)
       if trace then
         print(message "allExtensions thisStart=" << thisStart <<
               message " remComb=" << remComb << message " nodes=" << nodes)
       for n in nodes repeat
         for r in remComb repeat
           if r ~= [] then
             if trace then
               print(message "allExtensions thisStart=" << thisStart <<
                     message " remComb=" << remComb << message " nodes=" << nodes)
             e:Record(source:List NNI,target:List List NNI) := [n,r]
             e1 : Record(sublat:SubLattice,
                extension:List Record(source:List NNI,target:List List NNI)) := [thisStart,[e]]
             res := cons(topolExtension [e1], res)
     res

)abbrev domain TOPLAT TopologyLattice
++ Author: Martin Baker
++ Description:
++   A complete lattice, specified by basis nodes.
++   for more documentation see:
++ References:
++   https://www.euclideanspace.com/prog/scratchpad/mycode/topology/finite/

TopologyLattice() : Exports == Impl where
  NNI==> NonNegativeInteger
  x<<y ==> hconcat(x::OutputForm, y::OutputForm)
  LATTICE ==> List List NNI
  -- LATTICE holds a compete lattice where:
  --  the inner list is join of elements to give nodes
  --  outer list is basis
  --  taking the power set of the outer list gives all elements of lattice.

  Exports ==> SetCategory() with

    topologyLattice : (List List NNI) -> %
      ++ constructor

    topologyLattice2 : (List SubLattice) -> %
      ++ constructor

    topologyLatticeTrivial : () -> %
      ++ Constructor for trivial topology
      ++ Only empty(doesn't need to be explicitly included) and full open sets

    topologyLatticeDiscrete : (dim:NNI) -> %
      ++ Constructor for discrete topology
      ++ includes all open sets
      ++ Don't need to explicitly include empty

    topologyLatticeLeftOrder : (dim:NNI) -> %
      ++ Constructor for order topology
      ++ The order topology may be considered on partially ordered sets as
      ++ well as linearly ordered sets
      ++ The open sets are {x | x<b} where b is 1..max
      ++ On a linearly ordered set it coincides with the interval topology

    getTopology : (a:%) -> List List NNI
      ++ returns open sets as list of list

    getOpenSets : (a:%) -> List SubLattice
      ++ returns open sets as list of set

    full2basis : (a:%) -> %
      ++ Remove non-basis open sets
      ++ That is, for each element, only the smallest open set that includes it.

    basis2full : (a:%) -> %
      ++ Add all unions of open sets not already included

    validate : (a:%) -> Boolean

    validateAll : (a:List %) -> Boolean

    coerce : (x : %) -> OutputForm
      ++ display as symbols

    getDimension : (a : %) -> NNI

    product : (a : %, b : %) -> %

    powerSetGradedOld : (d:NNI,grade:NNI) -> List List NNI

    allLatticesNoRepeatedElements : (basis:List NNI,
                                 existingLattice : SubLattice,trace : Boolean) -> List SubLattice
      ++ exported for debug use only *********************************************

    nerveConstruction : (a : %) -> FiniteSimplicialComplex(Integer)
      ++ A nerve construction creates a simplicial complex with the
      ++ topological properties of a given set family.
      ++ The nerve construction is based on a cover of the set family
      ++ The resulting complex is a discrete representation of that cover.

    toOpenSet : (a1:%,top:List NNI) -> TopologyFinite

    toOpenSets : (a1:List %,top:List NNI) -> List TopologyFinite

    testValidTopol : (allDegree:List SubLattice,degree:NNI) -> Boolean

    allTopologiesAsLattice : (s : List NNI) -> List %
      ++ Given a set construct a list of all possible topologies on that set
      ++ Each of these topologies is made up from sub-lattices (complete lattices)
      ++ that cover the space.
      ++ Warning: This function can return very long lists, if the input set is 6 or
      ++ more elements then the computer may run out of resources and crash.
      ++ I have written an explanation of this algorithm on the web page here:
      ++ https://www.euclideanspace.com/maths/topology/topologicalSpace/finite/extension/index.htm

    countAllTopologiesOnSet : (s : List NNI) -> NNI
      ++ Given a set count all possible topologies on that set

  Impl ==> add

   -- A complete lattice, specified by basis nodes.
   Rep := Record(basis:Boolean,topology:List SubLattice)

   -- returns open sets as list of set
   getOpenSets(a:%) : List SubLattice ==
     a.topology

   getTopology(a:%) : LATTICE ==
     sub : List SubLattice := a.topology
     res : LATTICE := []
     for x in sub repeat
       m:LATTICE := membersBasis(x)
       res := concat (m,res)
     res

   setTopologyFromList(t:LATTICE) : List SubLattice ==
     [subLattice(a,[]) for a in t]

   -- constructor
   topologyLattice(a : LATTICE) : % ==
     [false,setTopologyFromList(a)]

   topologyLattice2(a : List SubLattice) : % ==
     [false,a]

   topologyLatticeTrivial() : % ==
     [false,empty]

   -- local function to add if new
   addIfNew(lst : LATTICE, unsorted : List NNI) : LATTICE ==
       if empty?(unsorted) then return lst
       sorted : List(NNI) := sort(unsorted)
       if member?(sorted, lst) then return lst
       cons(sorted,lst)

   -- generate discrete topology
   genDiscreteTopology(lst : LATTICE,level : NNI,
       thisOpenSet : List(NNI), dim : NNI) : LATTICE ==
     -- print(message "genDiscreteTopology(" << lst  << message ","
     --  << level  << message "," << thisOpenSet  << message "," << dim << message ")")
     top1:LATTICE := lst
     for i in 1..dim repeat
       openset1 : List NNI := [i]
       if not member?(i,thisOpenSet) then
         -- print(message "genDiscreteTopology not member(" << thisOpenSet  << message ","
         --   << i  << message ")")
         openset2 : List(NNI) := concat(thisOpenSet,openset1)
         if (level+1)<dim then
           top1 := genDiscreteTopology(top1,level+1,openset2,dim)
         top1 := addIfNew(top1,openset2)
     top1

   topologyLatticeDiscrete(dim:NNI) : % ==
     top1:LATTICE := empty
     top1 := genDiscreteTopology(top1,1,empty,dim)
     [false,setTopologyFromList(top1)]

   -- generate order topology
   genOrderTopology(lst : LATTICE,level : NNI,
       thisOpenSet : List(NNI), dim : NNI) : LATTICE ==
     -- print(message "genOrderTopology(" << lst  << message ","
     --  << level  << message "," << thisOpenSet  << message "," << dim << message ")")
     top1:LATTICE := lst
     openset1:List NNI := []
     for i in 1..dim repeat
       -- print(message "genOrderTopology loop(" << top1  << message "," << i  << message ")")
       openset1 := cons(i,openset1)
       top1 := cons(openset1,top1)
     reverse top1

   -- generate order topology
   topologyLatticeLeftOrder(dim:NNI) : % ==
     top1:LATTICE := empty
     top1 := genOrderTopology(top1,1,empty,dim)
     [false,setTopologyFromList(top1)]

   -- To find a basis: for every element of the set find the smallest
   -- open set that contains it.
   -- Remove non-basis open sets
   -- That is, for each element, only the smallest open set that includes it.
   full2basis(a:%) : % ==
     -- assume number of elements is maximum index
     numEle:NNI := 0
     top1:LATTICE := getTopology(a)
     for x in top1 repeat
       for y in x repeat
         if y>numEle then numEle:=y
     basisSets:LATTICE := empty
     for currEle in 1..numEle repeat
       basisCandidate:List NNI := empty
       minSize:NNI := 0
       for currOpenSet in top1 repeat
         currSize:NNI := #currOpenSet
         if member?(currEle,currOpenSet) and not empty?(currOpenSet) and
          (minSize=0 or currSize < minSize) then
            --print(message "adding" << currOpenSet  << message " minSize="
            --  << minSize << message " currEle=" << currEle)
            basisCandidate := currOpenSet
            minSize := #currOpenSet
       basisSets := addIfNew(basisSets,basisCandidate)
     [true,setTopologyFromList(basisSets)]

   unionLocal(a:List NNI, b:List NNI) : List NNI ==
     res:List NNI := a
     for x in b repeat
       if not member?(x, res) then res:=cons(x,res)
     res

   -- Add all unions of open sets not already included
   basis2full(a:%) : % ==
     top1:LATTICE := getTopology(a)
     top2:LATTICE := copy(top1) -- so we dont alter top1 inside loop
     for x in top1 repeat
       for y in top1 repeat
         z : List NNI := sort (unionLocal(x,y))
         top2 := addIfNew(top2,z)
         -- print(message "x=" << x  << message " y="
         --  << y << message " union=" << z)
     [false,setTopologyFromList(top2)]

   -- display
   coerce(x : %) : OutputForm ==
     x1:List SubLattice := x.topology
     msg:OutputForm := if x.basis then message "basis=" else message "topology="
     msg << bracket[(a::OutputForm) for a in x1]

   _=(a:%,b:%) : Boolean ==
     a.topology=b.topology

   validate(a1:%) : Boolean ==
     a:List SubLattice := a1.topology
     for x in a for i in 1.. repeat
       for y in a for j in 1.. repeat
         if i<j then
           if x=y then
             print(message "duplicate sub:lattice:" << x)
             return false
     true

   validateAll(a:List %) : Boolean ==
     for x in a for i in 1.. repeat
       if not validate(x) then
         print(message "not valid:" << x)
         return false
       for y in a for j in 1.. repeat
         if i<j then
           if x=y then
             print(message "duplicate " << x)
             return false
     true

   toOpenSet(a1:%,top:List NNI) : TopologyFinite ==
     res : List List NNI := []
     a:List SubLattice := a1.topology
     for x in a repeat
       os : List List NNI := openSets(x)
       -- print(message "toOpenSet x=" << x << message " os=" << os)
       res := setUnion(res,[y for y in os | (y ~= []) and (y ~= top)])
     topologyFinite res

   toOpenSets(a1:List %,top:List NNI) : List TopologyFinite ==
     [toOpenSet(x,top) for x in a1]

   -- For valid lattice all basis must be independant.
   -- They can only contain the same element once.
   isIndependant?(basis:List List NNI) : Boolean ==
     for x in basis for i in 1.. repeat
       for y in basis for j in 1.. repeat
         if i<j then
           if setIntersection(x,y) ~= [] then return false
     true

   -- All lattices where each 'element' is included 0 or 1 times but not more.
   -- An 'element' may be a basis element (such as 1) or a join of basis (such as 1\/2).
   -- if basis=[1,2] then output is: [],[1],[2],[1\/2],[1+2]
   -- if basis=[1,2,3] then output is: [],[1],[2],[3],[1\/2],[1\/3],[2\/3],[2+1],
   --                   [3+1],[3+2],[1+2\/3],[2+1\/3],[3+1\/2],[1\/2\/3],[3+2+1]
   -- Local function used by allTopologies function.
   allLatticesNoRepeatedElements(basis:List NNI,
                          existingLattice : SubLattice,trace : Boolean) : List SubLattice ==
     if trace then
       print(message "      allLatticesNoRepeatedElements basis=" << basis)
       print(message "      allLatticesNoRepeatedElements existingLattice=" << existingLattice)
     if #basis < 1 then
       return []
     res : List SubLattice := []
     for ele in basis repeat
       newBasis : List List NNI := [[ele]]
       newLattice: SubLattice := subLattice([],newBasis)
       if not empty1? existingLattice then
         -- following can cause duplicated basis
         if not isIndependant?(newBasis) then
           error "allLatticesNoRepeatedElements basis not independant."
         if trace then
           print(message "      allLatticesNoRepeatedElements existingLattice not empty. basis=" << basis <<
                 message " existingLattice=" << existingLattice)
       if empty? res
         then
           res := [subLattice([],[]),newLattice]
           -- subLattice([],[]) not stricly correct as empty lattice is
           -- not a valid lattice but is required as a marker.
         else
           if not isIndependant?(newBasis) then
             print(message "allLatticesNoRepeatedElements2 basis not independant. newBasis=" << newBasis)
             return res
           if trace then
             print(message "         allLatticesNoRepeatedElements3 basis=" << basis <<
                   message " existingLattice=" << existingLattice)
             print(message "         newBasis=" << newBasis << message " res=" << res)
           res : List SubLattice := nextVector(newLattice,res,false)
     if trace then
       print(message "      allLatticesNoRepeatedElements4 basis=" << basis <<
           message " existingLattice=" << existingLattice)
       print(message "         res=" << res)
     res

)if false

   -- Recursively called to construct a list of all possible topologies on that set.
   -- Parameters:
   -- thisRemainder - elements yet to be covered
   -- existingLattice - sub-lattice below this one
   -- subLatticeStack - A list of the subLattices below this.
   allTopologies(level:NNI,thisRemainder : List NNI,
        existingLattice : SubLattice, subLatticeStack : List SubLattice,
        topologyStack : List %,trace : Boolean) : List % ==
     -- *************** switch on trace here for debug ******************************
     --if getBasis(lattice)=[[1],[2]] and bottom=[4]
     --if bottom=[4]
     --     and existingLattice=[[3]] then
     --  if trace=false then print(message "allTopologies trace switched on for " << thisRemainder <<
     --                            message " level=" << level)
     --trace:=true
     -- *****************************************************************************
     res:List % := topologyStack
     if trace then
       print(message "allTopologies1 level=" << level <<
             message " thisRemainder=" << thisRemainder)
       print(message " existingLattice=" << existingLattice <<
             message " subLatticeStack=" << subLatticeStack <<
             message " topologyStack=" << topologyStack)
     all1 : List SubLattice := allLatticesNoRepeatedElements(thisRemainder,existingLattice,false)
     all : List SubLattice := []
     for lat in all1 repeat
       lat1 : SubLattice := merge(existingLattice,lat)
       if not subset?(lat1,existingLattice)
         then
           all := cons(lat1,all)
           --print(message "allTopologies2:" << lat1 << message " is not subset of:" << existingLattice)
         --else
           --print(message "allTopologies2:" << lat1 << message " is subset of:" << existingLattice)
     --if trace then  print(message " all=" << all)
     for lattice in all repeat
       innerRes:List SubLattice := subLatticeStack -- A list of the subLattices below this.
       if not empty1? lattice then
         remainingBasis : List NNI := subtractElements(thisRemainder,lattice)
         innerRes := cons(lattice,innerRes)
         if remainingBasis=[]
           then
             -- this topology is complete so add it to list
             res := cons(topologyLattice2(reverse innerRes),res)
             --if trace then
             --  print(message "   allTopologies *** top level ****")
           else
             -- Topology not yet complete so generate more lattices recursively
             -- allNodes expands out basis elements of current lattice into all
             -- combinations of basis elements (powerset) with no offset (bottom
             -- not included).
             allNodes : List List NNI := openSetsNoOffset lattice
             -- This gives all elements (not just basis) in current lattice
             for newBottom in allNodes repeat
               -- *************************************************************
               -- need to allow multiple bottom elements
               -- *************************************************************
               if not (newBottom=[]) then
                 -- subFace re-factors to give a SubLattice whose bottom is the given element
                 -- and whose basis elements are all in the current lattice
                 must: SubLattice := subFace(lattice,newBottom)
                 if level>999 then error "loop detected"
                 res := allTopologies(level+1,remainingBasis,
                                        must,innerRes,res,trace)
     if trace then print(message "   allTopologies complete res=" << res)
     reverse res

)endif

   -- local recursive helper function for openSets
   -- to generate complete lattice (power set)
   powerSet(s:List NNI) : List List NNI ==
     empty? s => [s]
     concat(p:=powerSet(rest s),[cons(first s,x) for x in p])

   -- Recursively called to construct a list of all possible topologies on that set.
   -- Parameters:
   -- thisRemainder - elements yet to be covered
   -- existingLattice - sub-lattice below this one
   -- subLatticeStack - A list of the subLattices below this.
   allTopologies(level:NNI,thisRemainder : List NNI,
        existingLattice : SubLattice, subLatticeStack : List SubLattice,
        topologyStack : List %,trace : Boolean) : List % ==
     -- *************** switch on trace here for debug ******************************
     --if getBasis(lattice)=[[1],[2]] and bottom=[4]
     --if bottom=[4]
     --     and existingLattice=[[3]] then
     --  if trace=false then print(message "allTopologies trace switched on for " << thisRemainder <<
     --                            message " level=" << level)
     --trace:=true
     -- *****************************************************************************
     res:List % := topologyStack
     if trace then
       print(message "allTopologies1 level=" << level <<
             message " thisRemainder=" << thisRemainder)
       print(message " existingLattice=" << existingLattice <<
             message " subLatticeStack=" << subLatticeStack <<
             message " topologyStack=" << topologyStack)
     all1 : List SubLattice := allLatticesNoRepeatedElements(thisRemainder,existingLattice,false)
     all : List SubLattice := []
     for lat in all1 repeat
       lat1 : SubLattice := merge(existingLattice,lat)
       if not subset?(lat1,existingLattice)
         then
           all := cons(lat1,all)
           --print(message "allTopologies2:" << lat1 << message " is not subset of:" << existingLattice)
         --else
           --print(message "allTopologies2:" << lat1 << message " is subset of:" << existingLattice)
     --if trace then  print(message " all=" << all)
     for lattice in all repeat
       innerRes:List SubLattice := subLatticeStack -- A list of the subLattices below this.
       if not empty1? lattice then
         remainingBasis : List NNI := subtractElements(thisRemainder,lattice)
         innerRes := cons(lattice,innerRes)
         if remainingBasis=[]
           then
             -- this topology is complete so add it to list
             res := cons(topologyLattice2(reverse innerRes),res)
             --if trace then
             --  print(message "   allTopologies *** top level ****")
           else
             -- Topology not yet complete so generate more lattices recursively
             -- allNodes expands out basis elements of current lattice into all
             -- combinations of basis elements (powerset) with no offset (bottom
             -- not included).
             allNodes : List List NNI := openSetsNoOffset lattice
             -- This gives all elements (not just basis) in current lattice
             for newBottom in allNodes repeat
               res1:List % := []
               -- *************************************************************
               -- need to allow multiple bottom elements
               -- *************************************************************
               if not (newBottom=[]) then
                 -- subFace re-factors to give a SubLattice whose bottom is the given element
                 -- and whose basis elements are all in the current lattice
                 must: SubLattice := subFace(lattice,newBottom)
                 if level>999 then error "loop detected"
                 res1 := allTopologies(level+1,remainingBasis,must,innerRes,res1,trace)
               print(message "#res1=" << #res1)
               --i : List List NNI := powerSet([x for x in 1..(#res1)])
               res := concat(res,res1)
     if trace then print(message "   allTopologies complete res=" << res)
     reverse res

   -- Given a set, construct a list of all possible topologies on that set
   -- Each of these topologies is made up from sub-lattices (complete lattices of open sets)
   -- that cover the space.
   -- Warning: This function can return very long lists, if the input set is 6 or
   -- more elements then the computer may run out of resources and crash.
   -- I have written an explanation of this algorithm on the web page here:
   -- https://www.euclideanspace.com/maths/topology/topologicalSpace/finite/extension/index.htm
   allTopologiesAsLattice(topLevel : List NNI) : List % ==
     -- call recursively
     allTopologies(1,topLevel,subLattice([],[]),[],[],false)

